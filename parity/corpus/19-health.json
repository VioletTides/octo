    {"name": "cleanup-wait", "path": "/api/song/{{kh_tidewater}}", "session": null, "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}, "until": {"from": "json:missing", "in": [true]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["createdAt", "updatedAt", "birthTime", "playDate"]},
