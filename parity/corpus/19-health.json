    {"name": "undo-covers-wait", "path": "/api/admin/health/run", "until": {"from": "json:run.state", "in": ["done", "stopped", "failed"]}, "pollMs": 300, "timeoutMs": 30000, "ignoreKeys": ["checking"]},
    {"name": "pics-tidewater-undone", "exec": ["ffprobe", "-v", "error", "-show_entries", "stream=index,codec_type,codec_name,width,height:stream_disposition=attached_pic", "-of", "json", "/music/Kestrel Moor/Slate Coast (2019)/02 - Tidewater.flac"]},
    {"name": "settle4-octo-scan", "path": "/rest/getScanStatus", "auth": "p", "f": "json", "delayBeforeMs": 10000, "until": {"from": "json:subsonic-response.scanStatus.scanning", "in": [false]}, "pollMs": 500, "timeoutMs": 30000, "ignoreKeys": ["count", "folderCount", "lastScan", "elapsedTime", "scanType"]},
    {"name": "settle4-scan", "path": "/rest/startScan", "auth": "p", "f": "json", "query": [["fullScan", "true"]], "ignoreKeys": ["count", "folderCount", "scanning", "lastScan", "elapsedTime", "scanType"]},
    {"name": "settle4-tidewater-bare", "path": "/api/song/{{kh_tidewater}}", "session": null, "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}, "delayBeforeMs": 1500, "until": {"from": "json:hasCoverArt", "in": [false]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["createdAt", "updatedAt", "birthTime", "playDate"]},
