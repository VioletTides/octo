{
  "group": "library-health",
  "description": "Library health on the server (/api/admin/health and its run, preview, apply, lookup, stop, undo). Plants 7 songs with known problems (parity/fixtures/planted/health, copied in by exec and scanned), reads the findings with library actions off, then turns them on through a settings patch (dry run first, then real), previews every check, runs fixes one run at a time and waits for each run and for Navidrome, undoes two runs, and finally removes the planted songs and turns library actions off again so later files see the library and settings as before. Captured song ids come from the first report (checks are in a fixed order: duplicates, splitAlbums, noLength, noTrackNumber, noCover, noYear, noGenre).",
  "defaults": {"auth": "none", "session": "admin", "backlog": "R"},
  "requests": [
    {"name": "plant-files", "exec": ["sh", "-c", "cp -a '/parity-planted/health/Kestrel Moor' /music/ && find '/music/Kestrel Moor' -exec touch -h -d @1577909045 {} + && cd /music && find 'Kestrel Moor' -type f | LC_ALL=C sort"]},
    {"name": "plant-scan", "path": "/rest/startScan", "auth": "p", "f": "json", "query": [["fullScan", "true"]], "ignoreKeys": ["count", "folderCount", "scanning", "lastScan", "elapsedTime", "scanType"]},
    {"name": "plant-scan-done", "path": "/rest/getScanStatus", "auth": "p", "f": "json", "delayBeforeMs": 2000, "until": {"from": "json:subsonic-response.scanStatus.scanning", "in": [false]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["count", "folderCount", "lastScan", "elapsedTime", "scanType"]},
    {"name": "plant-wait", "path": "/rest/search3", "auth": "p", "f": "json", "query": [["query", "Kestrel"], ["artistCount", "1"], ["albumCount", "5"], ["songCount", "20"]], "until": {"from": "json:subsonic-response.searchResult3.song[6].artist", "in": ["Kestrel Moor"]}, "pollMs": 500, "timeoutMs": 60000, "unordered": true, "ignoreKeys": ["created", "played", "coverArt", "artistImageUrl"], "capture": {"kh_artist": {"from": "json:subsonic-response.searchResult3.artist[0].id", "normalize": false}, "kp_harbor_flac": "regex:\"id\":\"(\\w+)\",\"parent\":\"\\w+\",\"isDir\":false,\"title\":\"Harbor Lights\",\"album\":\"Slate Coast\"", "kp_harbor_mp3": "regex:\"id\":\"(\\w+)\",\"parent\":\"\\w+\",\"isDir\":false,\"title\":\"Harbor Lights\",\"album\":\"Harbor Lights\"", "kp_tidewater": "regex:\"id\":\"(\\w+)\",\"parent\":\"\\w+\",\"isDir\":false,\"title\":\"Tidewater\"", "kp_gull": "regex:\"id\":\"(\\w+)\",\"parent\":\"\\w+\",\"isDir\":false,\"title\":\"Gull Song\"", "kp_breakwater": "regex:\"id\":\"(\\w+)\",\"parent\":\"\\w+\",\"isDir\":false,\"title\":\"Breakwater\"", "kp_spark": "regex:\"id\":\"(\\w+)\",\"parent\":\"\\w+\",\"isDir\":false,\"title\":\"Spark\"", "kp_undertow": "regex:\"id\":\"(\\w+)\",\"parent\":\"\\w+\",\"isDir\":false,\"title\":\"Undertow\""}},
    {"name": "health-signed-out", "path": "/api/admin/health", "session": null, "anyKeyOrder": true},
    {"name": "health-recovery", "path": "/api/admin/health", "session": "recovery", "anyKeyOrder": true},
    {"name": "run-recovery", "path": "/api/admin/health/run", "session": "recovery"},
    {"name": "run-none", "path": "/api/admin/health/run"},
    {"name": "health-off-fresh", "path": "/api/admin/health", "query": [["fresh", "1"]], "delayBeforeMs": 1000, "capture": {"kh_dup_key": "json:checks[0].sets[0].key", "kh_harbor_flac": "json:checks[0].sets[0].keep", "kh_harbor_mp3": "json:checks[0].sets[0].copies[1]", "kh_split_key": {"from": "json:checks[1].albums[0].key", "normalize": false}, "kh_album_main": {"from": "json:checks[1].albums[0].parts[0].albumId", "normalize": false}, "kh_album_split": {"from": "json:checks[1].albums[0].parts[1].albumId", "normalize": false}, "kh_undertow": "json:checks[1].albums[0].parts[1].songs[0]", "kh_spark": "json:checks[2].songs[0]", "kh_breakwater": "json:checks[3].songs[0]", "kh_tidewater": "json:checks[5].songs[0]", "kh_gull": "json:checks[6].songs[0]"}, "anyKeyOrder": true},
    {"name": "health-off-cached", "path": "/api/admin/health", "anyKeyOrder": true},
    {"name": "health-fresh-true", "path": "/api/admin/health", "query": [["fresh", "true"]], "anyKeyOrder": true},
    {"name": "preview-off-noyear", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "noYear"}}},
    {"name": "preview-no-admin-header", "method": "POST", "path": "/api/admin/health/preview", "body": {"json": {"check": "noYear"}}},
    {"name": "preview-signed-out", "method": "POST", "path": "/api/admin/health/preview", "session": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "noYear"}}},
    {"name": "apply-off", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"label": "Fill in 1 song", "check": "noYear", "steps": [{"action": "retag", "id": "{{kh_tidewater}}", "title": "Tidewater", "with": {"year": "2019"}}]}}},
    {"name": "lookup-off", "method": "POST", "path": "/api/admin/health/lookup", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"ids": ["{{kh_breakwater}}"], "check": "noTrackNumber"}}},
    {"name": "undo-off", "method": "POST", "path": "/api/admin/health/undo", "headers": {"X-Octo-Admin": "1"}},
    {"name": "stop-idle", "method": "POST", "path": "/api/admin/health/stop", "headers": {"X-Octo-Admin": "1"}},
    {"name": "settings-enable-dryrun", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"LibraryActions": {"Enabled": true, "DryRun": true, "AllowedUsers": ["admin"], "Actions": [{"Action": "Delete", "Enabled": true}]}}}, "ignoreKeys": ["persisted"]},
    {"name": "wait-enabled", "path": "/rest/getLibraryActions", "auth": "p", "f": "json", "until": {"from": "json:subsonic-response.libraryActions.enabled", "in": [true]}, "pollMs": 300, "timeoutMs": 20000},
    {"name": "health-dryrun", "path": "/api/admin/health", "anyKeyOrder": true},
    {"name": "preview-dryrun-noyear", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "noYear"}}},
    {"name": "apply-dryrun", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"label": "Fill in 1 song", "check": "noYear", "steps": [{"action": "retag", "id": "{{kh_tidewater}}", "title": "Tidewater", "with": {"year": "2019"}}]}}, "capture": {"run_dry": "json:run.id"}, "ignoreKeys": ["current", "done"]},
    {"name": "apply-dryrun-wait", "path": "/api/admin/health/run", "until": {"from": "json:run.state", "in": ["done", "stopped", "failed"]}, "pollMs": 300, "timeoutMs": 30000},
    {"name": "settings-dryrun-off", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"LibraryActions": {"DryRun": false}}}, "ignoreKeys": ["persisted"]},
    {"name": "wait-real", "path": "/rest/getLibraryActions", "auth": "p", "f": "json", "until": {"from": "json:subsonic-response.libraryActions.dryRun", "in": [false]}, "pollMs": 300, "timeoutMs": 20000},
    {"name": "health-real", "path": "/api/admin/health", "anyKeyOrder": true},
    {"name": "preview-empty", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {}}},
    {"name": "preview-unknown-check", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "loudness"}}},
    {"name": "preview-notrack-lookup-only", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "noTrackNumber"}}},
    {"name": "preview-noalbumartist-none", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "NOALBUMARTIST"}}},
    {"name": "preview-dups", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "duplicates"}}},
    {"name": "preview-dups-keep-mp3", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "duplicates", "keys": ["{{kh_dup_key}}"], "keep": "{{kh_harbor_mp3}}", "fills": [], "choose": {"album": "Slate Coast", "year": "2019"}}}},
    {"name": "preview-dups-gone", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "duplicates", "keys": ["dup|not-a-set"]}}},
    {"name": "preview-split", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "splitAlbums"}}},
    {"name": "preview-split-key", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "splitAlbums", "keys": ["{{kh_split_key}}"]}}},
    {"name": "preview-split-gone", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "splitAlbums", "keys": ["split|nope"]}}},
    {"name": "preview-noyear", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "noYear"}}},
    {"name": "preview-nogenre", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "noGenre"}}},
    {"name": "preview-nocover-some", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "noCover", "keys": ["{{kh_harbor_flac}}", "{{kh_tidewater}}", "{{song_m4a_1}}"]}}},
    {"name": "preview-nocover-gone", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "noCover", "keys": ["not-a-song"]}}},
    {"name": "preview-nolength", "method": "POST", "path": "/api/admin/health/preview", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"check": "noLength"}}},
    {"name": "apply-empty", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {}}},
    {"name": "apply-unknown-action", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"steps": [{"action": "explode", "id": "{{kh_tidewater}}"}]}}},
    {"name": "apply-no-id", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"steps": [{"action": "retag", "id": " ", "with": {"year": "2019"}}]}}},
    {"name": "apply-retag-no-tags", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"steps": [{"action": "retag", "id": "{{kh_tidewater}}", "title": "Tidewater"}]}}},
    {"name": "apply-retag-unknown-tag", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"steps": [{"action": "retag", "id": "{{kh_tidewater}}", "title": "Tidewater", "with": {"mood": "calm"}}]}}},
    {"name": "apply-retag-bad-year", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"steps": [{"action": "retag", "id": "{{kh_tidewater}}", "title": "Tidewater", "with": {"YEAR": "20x9"}}]}}},
    {"name": "apply-join-no-like", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"steps": [{"action": "joinAlbum", "id": "{{kh_undertow}}", "title": "Undertow"}]}}},
    {"name": "lookup-empty", "method": "POST", "path": "/api/admin/health/lookup", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {}}},
    {"name": "lookup-blank-ids", "method": "POST", "path": "/api/admin/health/lookup", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"ids": ["", " "]}}},
    {"name": "lookup-too-many", "method": "POST", "path": "/api/admin/health/lookup", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"ids": ["s01", "s02", "s03", "s04", "s05", "s06", "s07", "s08", "s09", "s10", "s11", "s12", "s13", "s14", "s15", "s16", "s17", "s18", "s19", "s20", "s21", "s22", "s23", "s24", "s25", "s26"]}}},
    {"name": "lookup-slow", "method": "POST", "path": "/api/admin/health/lookup", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"ids": ["{{kh_breakwater}}", "{{kh_tidewater}}", "{{kh_gull}}"], "check": "noTrackNumber"}}, "capture": {"run_look1": "json:run.id"}, "ignoreKeys": ["current", "done"]},
    {"name": "run-while-looking", "path": "/api/admin/health/run", "delayBeforeMs": 300},
    {"name": "apply-busy", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"label": "Fill in 1 song", "check": "noYear", "steps": [{"action": "retag", "id": "{{kh_tidewater}}", "title": "Tidewater", "with": {"year": "2019"}}]}}},
    {"name": "lookup-busy", "method": "POST", "path": "/api/admin/health/lookup", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"ids": ["{{kh_spark}}"]}}},
    {"name": "undo-busy", "method": "POST", "path": "/api/admin/health/undo", "headers": {"X-Octo-Admin": "1"}},
    {"name": "stop-looking", "method": "POST", "path": "/api/admin/health/stop", "headers": {"X-Octo-Admin": "1"}},
    {"name": "lookup-slow-wait", "path": "/api/admin/health/run", "until": {"from": "json:run.state", "in": ["done", "stopped", "failed"]}, "pollMs": 300, "timeoutMs": 30000},
    {"name": "stop-after", "method": "POST", "path": "/api/admin/health/stop", "headers": {"X-Octo-Admin": "1"}},
    {"name": "lookup-one", "method": "POST", "path": "/api/admin/health/lookup", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"ids": ["{{kh_breakwater}}", "not-a-song", "{{kh_breakwater}}"], "check": "noTrackNumber"}}, "capture": {"run_look2": "json:run.id"}, "ignoreKeys": ["current", "done"]},
    {"name": "lookup-one-wait", "path": "/api/admin/health/run", "until": {"from": "json:run.state", "in": ["done", "stopped", "failed"]}, "pollMs": 300, "timeoutMs": 30000},
    {"name": "apply-notrack", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"label": "Filling in tags", "check": "noTrackNumber", "steps": [{"action": "retag", "id": "{{kh_breakwater}}", "title": "Breakwater", "with": {"track": "4", "isrc": "QZPAR1900104"}}]}}, "capture": {"run_fix1": "json:run.id"}, "ignoreKeys": ["current", "done"]},
    {"name": "apply-notrack-wait", "path": "/api/admin/health/run", "until": {"from": "json:run.state", "in": ["done", "stopped", "failed"]}, "pollMs": 300, "timeoutMs": 30000, "ignoreKeys": ["checking"]},
    {"name": "apply-noyear", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"label": "Filling in tags", "check": "noYear", "steps": [{"action": "retag", "id": "{{kh_tidewater}}", "title": "Tidewater", "with": {"year": "2019"}}]}}, "capture": {"run_fix2": "json:run.id"}, "ignoreKeys": ["current", "done"]},
    {"name": "apply-noyear-wait", "path": "/api/admin/health/run", "until": {"from": "json:run.state", "in": ["done", "stopped", "failed"]}, "pollMs": 300, "timeoutMs": 30000, "ignoreKeys": ["checking"]},
    {"name": "apply-nogenre", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"label": "Filling in tags", "check": "noGenre", "steps": [{"action": "retag", "id": "{{kh_gull}}", "title": "Gull Song", "with": {"genre": "Folk"}}]}}, "capture": {"run_fix3": "json:run.id"}, "ignoreKeys": ["current", "done"]},
    {"name": "apply-nogenre-wait", "path": "/api/admin/health/run", "until": {"from": "json:run.state", "in": ["done", "stopped", "failed"]}, "pollMs": 300, "timeoutMs": 30000, "ignoreKeys": ["checking"]},
    {"name": "apply-split", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"label": "Joining albums", "check": "splitAlbums", "steps": [{"action": "joinAlbum", "id": "{{kh_undertow}}", "title": "Undertow", "with": {"like": "{{kh_harbor_flac}}"}}]}}, "capture": {"run_fix4": "json:run.id"}, "ignoreKeys": ["current", "done"]},
    {"name": "apply-split-wait", "path": "/api/admin/health/run", "until": {"from": "json:run.state", "in": ["done", "stopped", "failed"]}, "pollMs": 300, "timeoutMs": 30000, "ignoreKeys": ["checking"]},
    {"name": "health-settled", "path": "/api/admin/health", "anyKeyOrder": true},
    {"name": "settle1-octo-scan", "path": "/rest/getScanStatus", "auth": "p", "f": "json", "delayBeforeMs": 10000, "until": {"from": "json:subsonic-response.scanStatus.scanning", "in": [false]}, "pollMs": 500, "timeoutMs": 30000, "ignoreKeys": ["count", "folderCount", "lastScan", "elapsedTime", "scanType"]},
    {"name": "settle1-scan", "path": "/rest/startScan", "auth": "p", "f": "json", "query": [["fullScan", "true"]], "ignoreKeys": ["count", "folderCount", "scanning", "lastScan", "elapsedTime", "scanType"]},
    {"name": "settle1-breakwater", "path": "/rest/getSong", "auth": "p", "f": "json", "query": [["id", "{{kh_breakwater}}"]], "until": {"from": "json:subsonic-response.song.track", "in": [4]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["created", "played"]},
    {"name": "settle1-tidewater", "path": "/rest/getSong", "auth": "p", "f": "json", "query": [["id", "{{kh_tidewater}}"]], "until": {"from": "json:subsonic-response.song.year", "in": [2019]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["created", "played"]},
    {"name": "settle1-gull", "path": "/rest/getSong", "auth": "p", "f": "json", "query": [["id", "{{kh_gull}}"]], "until": {"from": "json:subsonic-response.song.genre", "in": ["Folk"]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["created", "played"]},
    {"name": "settle1-joined", "path": "/rest/getAlbum", "auth": "p", "f": "json", "query": [["id", "{{kh_album_main}}"]], "until": {"from": "json:subsonic-response.album.songCount", "in": [6]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["created", "played"]},
    {"name": "tags-breakwater", "exec": ["ffprobe", "-v", "error", "-show_entries", "format_tags", "-of", "json", "/music/Kestrel Moor/Slate Coast (2019)/Breakwater.flac"]},
    {"name": "tags-tidewater", "exec": ["ffprobe", "-v", "error", "-show_entries", "format_tags", "-of", "json", "/music/Kestrel Moor/Slate Coast (2019)/02 - Tidewater.flac"]},
    {"name": "tags-undertow", "exec": ["ffprobe", "-v", "error", "-show_entries", "format_tags", "-of", "json", "/music/Kestrel Moor/Slate Coast (2019)/06 - Undertow.flac"]},
    {"name": "health-after-fixes", "path": "/api/admin/health", "query": [["fresh", "1"]], "anyKeyOrder": true},
    {"name": "apply-dups", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"label": "Fixing copies", "check": "duplicates", "steps": [{"action": "remove", "id": "{{kh_harbor_mp3}}", "title": "Harbor Lights", "with": {"copy": "true"}}]}}, "capture": {"run_fix5": "json:run.id"}, "ignoreKeys": ["current", "done"]},
    {"name": "apply-dups-wait", "path": "/api/admin/health/run", "until": {"from": "json:run.state", "in": ["done", "stopped", "failed"]}, "pollMs": 300, "timeoutMs": 30000, "ignoreKeys": ["checking"]},
    {"name": "trash-after-dups", "exec": ["sh", "-c", "cd /music/.octo-trash && find . -type f | sed -E 's#^\\./[0-9]{4}-[0-9]{2}-[0-9]{2}/#./DAY/#' | LC_ALL=C sort"]},
    {"name": "settle2-octo-scan", "path": "/rest/getScanStatus", "auth": "p", "f": "json", "delayBeforeMs": 10000, "until": {"from": "json:subsonic-response.scanStatus.scanning", "in": [false]}, "pollMs": 500, "timeoutMs": 30000, "ignoreKeys": ["count", "folderCount", "lastScan", "elapsedTime", "scanType"]},
    {"name": "settle2-mp3-missing", "path": "/api/song/{{kh_harbor_mp3}}", "session": null, "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}, "until": {"from": "json:missing", "in": [true]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["createdAt", "updatedAt", "birthTime", "playDate"]},
    {"name": "health-after-dups", "path": "/api/admin/health", "query": [["fresh", "1"]], "anyKeyOrder": true},
    {"name": "undo-dups", "method": "POST", "path": "/api/admin/health/undo", "headers": {"X-Octo-Admin": "1"}, "capture": {"run_undo1": "json:run.id"}, "ignoreKeys": ["current", "done"]},
    {"name": "undo-dups-wait", "path": "/api/admin/health/run", "until": {"from": "json:run.state", "in": ["done", "stopped", "failed"]}, "pollMs": 300, "timeoutMs": 30000, "ignoreKeys": ["checking"]},
    {"name": "undo-nothing", "method": "POST", "path": "/api/admin/health/undo", "headers": {"X-Octo-Admin": "1"}},
    {"name": "trash-after-undo", "exec": ["sh", "-c", "cd /music/.octo-trash && find . -type f | LC_ALL=C sort; ls -1 '/music/Kestrel Moor/Harbor Lights (2018)'"]},
    {"name": "settle3-octo-scan", "path": "/rest/getScanStatus", "auth": "p", "f": "json", "delayBeforeMs": 10000, "until": {"from": "json:subsonic-response.scanStatus.scanning", "in": [false]}, "pollMs": 500, "timeoutMs": 30000, "ignoreKeys": ["count", "folderCount", "lastScan", "elapsedTime", "scanType"]},
    {"name": "settle3-mp3-back", "path": "/api/song/{{kh_harbor_mp3}}", "session": null, "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}, "until": {"from": "json:missing", "in": [false]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["createdAt", "updatedAt", "birthTime", "playDate"]},
    {"name": "health-after-undo", "path": "/api/admin/health", "query": [["fresh", "1"]], "anyKeyOrder": true},
    {"name": "apply-covers", "method": "POST", "path": "/api/admin/health/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"label": "Finding covers", "check": "noCover", "steps": [{"action": "cover", "id": "{{kh_harbor_flac}}", "title": "Harbor Lights"}, {"action": "cover", "id": "{{kh_tidewater}}", "title": "Tidewater"}, {"action": "cover", "id": "{{song_m4a_1}}", "title": "First Love"}]}}, "capture": {"run_fix6": "json:run.id"}, "ignoreKeys": ["current", "done"]},
    {"name": "apply-covers-wait", "path": "/api/admin/health/run", "until": {"from": "json:run.state", "in": ["done", "stopped", "failed"]}, "pollMs": 300, "timeoutMs": 60000, "ignoreKeys": ["checking"]},
    {"name": "pics-tidewater-covered", "exec": ["ffprobe", "-v", "error", "-show_entries", "stream=index,codec_type,codec_name,width,height:stream_disposition=attached_pic", "-of", "json", "/music/Kestrel Moor/Slate Coast (2019)/02 - Tidewater.flac"]},
    {"name": "run-undo-count", "path": "/api/admin/health/run", "ignoreKeys": ["checking"]},
