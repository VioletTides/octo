{
  "group": "acquisition",
  "description": "It starts with the discovery search again: 15-radio registers the same Zephyr Echo ids from Last.fm without an album, which would leave Paper Moons with no album (no album query in Find songs, a different file name and tags). End to end, run last. A heart on Neon Tide ({{ext_song2}}) goes slskd search -> batch enqueue (the stub writes bodies/neon-tide.flac into Octo's job folder) -> transfer polls -> length, AcoustID (stubbed, confirmed) and spectrum checks -> identification (Deezer, MusicBrainz release) -> tags, cover, Organized filing under /music/Zephyr Echo/Glass Harbor -> Navidrome scan -> done with a library id, a fetched-songs entry and a saved log. A heart on Paper Moons ({{ext_song3}}) gets a file of the wrong length from kilo, throws it away and remembers the peer; Find songs then shows that file as refused, a pick of it is refused, and a pick of lima's copy (an M4A named .flac, too small to fit) is fetched, renamed to .m4a, tagged explicit and filed into the same album folder. The Neon Tide heart waits 31 s first (an earlier file's scan may be recent) and the lima pick 25 s (its last scan is Neon Tide's, at least 8 s back), so Navidrome's 30 s scan debounce never swallows the scan that shows the new song.",
  "defaults": {"backlog": "D"},
  "requests": [
    {"name": "outside-songs-again", "path": "/rest/search3", "auth": "p", "f": "json", "query": [["query", "zephyr"]]},
    {"name": "heart-neon", "path": "/rest/star", "auth": "p", "f": "json", "query": [["id", "{{ext_song2}}"]], "delayBeforeMs": 31000},
    {"name": "heart-neon-row", "path": "/rest/getAcquisition", "auth": "p", "query": [["key", "soulseek:{{ext_song2}}"]], "until": {"from": "json:subsonic-response.acquisition.state", "in": ["done", "failed"]}, "pollMs": 1000, "timeoutMs": 180000, "capture": {"neon_lib_id": "json:subsonic-response.acquisition.libraryId"}, "ignoreKeys": ["event", "logLines"], "backlog": "D,B,C"},
    {"name": "heart-neon-log", "path": "/rest/getAcquisition", "auth": "p", "query": [["key", "soulseek:{{ext_song2}}"]], "until": {"regex": "\"kind\":\"lyrics\""}, "pollMs": 1000, "timeoutMs": 60000, "unordered": true, "backlog": "D,B,C"},
    {"name": "heart-neon-history-file", "exec": ["cat", "/app/config/downloads-history.json"], "until": {"regex": "\"Kind\":\"lyrics\""}, "pollMs": 1000, "timeoutMs": 30000, "unordered": true, "ignoreKeys": ["StageSeconds", "DetailsPrefetchHit", "SizeBytes"], "backlog": "D,C"},
    {"name": "heart-neon-tags", "exec": ["ffprobe", "-v", "error", "-show_entries", "format=format_name,duration:format_tags:stream=index,codec_type,codec_name,sample_rate,channels,width,height:stream_disposition=attached_pic:stream_tags", "-of", "json", "/music/Zephyr Echo/Glass Harbor/Neon Tide.flac"], "backlog": "C"},
    {"name": "heart-neon-files", "exec": ["sh", "-c", "cd /music && find './Zephyr Echo' -type f -print | LC_ALL=C sort; test -f .mappings.json && echo mappings-file: yes; echo staged-left: $(find /music/.octo-incoming -type f 2>/dev/null | wc -l)"], "backlog": "D,C"},
    {"name": "heart-neon-mappings", "exec": ["cat", "/music/.mappings.json"], "unordered": true},
    {"name": "heart-neon-history-list", "path": "/api/admin/downloads", "session": "admin", "ignoreKeys": ["stageSeconds", "detailsPrefetchHit", "sizeBytes"], "capture": {"neon_at": "json:downloads[0].downloadedAt"}},
    {"name": "heart-neon-saved-log", "path": "/api/admin/downloads/log", "session": "admin", "query": [["key", "soulseek:{{ext_song2}}"], ["at", "{{neon_at}}"]], "unordered": true},
    {"name": "heart-neon-live-log", "path": "/api/admin/downloads/log", "session": "admin", "query": [["key", "soulseek:{{ext_song2}}"]], "unordered": true},
    {"name": "heart-neon-acquisitions-admin", "path": "/api/admin/acquisitions", "session": "admin", "capture": {"neon_lib_id_listed": "json:acquisitions[0].libraryId"}},
    {"name": "heart-neon-acquisitions-sub", "path": "/rest/getAcquisitions", "auth": "p", "f": "json"},
    {"name": "heart-neon-acquisitions-listener", "path": "/rest/getAcquisitions", "auth": "listener", "f": "json"},
    {"name": "heart-neon-library-song", "path": "/rest/getSong", "auth": "p", "f": "json", "query": [["id", "{{neon_lib_id}}"]], "ignoreKeys": ["size"], "backlog": "C"},
    {"name": "heart-neon-external-id-now", "path": "/rest/getSong", "auth": "p", "f": "json", "query": [["id", "{{ext_song2}}"]], "ignoreKeys": ["size"]},
    {"name": "heart-neon-relay-download", "path": "/rest/download", "auth": "p", "query": [["id", "{{neon_lib_id}}"]], "headers": {"Range": "bytes=0-3"}, "backlog": "B"},
    {"name": "heart-neon-find-cover", "path": "/api/admin/find/cover", "session": "admin", "query": [["id", "{{neon_lib_id}}"]]},
    {"name": "heart-neon-find-now-library", "method": "POST", "path": "/api/admin/find", "session": "admin", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"id": "{{ext_song2}}"}}, "ignoreKeys": ["size", "id"]},
    {"name": "heart-paper", "path": "/rest/star", "auth": "p", "f": "json", "query": [["id", "{{ext_song3}}"]]},
    {"name": "heart-paper-row", "path": "/rest/getAcquisition", "auth": "p", "query": [["key", "soulseek:{{ext_song3}}"]], "until": {"from": "json:subsonic-response.acquisition.state", "in": ["done", "failed"]}, "pollMs": 1000, "timeoutMs": 120000, "backlog": "D,B"},
    {"name": "heart-paper-denied-file", "exec": ["cat", "/app/config/rejected-peers.json"], "until": {"regex": "kilo"}, "pollMs": 2000, "timeoutMs": 30000, "backlog": "D,B"},
    {"name": "heart-paper-nothing-filed", "exec": ["sh", "-c", "ls -1 '/music/Zephyr Echo/Glass Harbor'; echo staged-left: $(find /music/.octo-incoming -type f 2>/dev/null | wc -l)"]},
    {"name": "heart-paper-history-unchanged", "path": "/api/admin/downloads", "session": "admin", "ignoreKeys": ["stageSeconds", "detailsPrefetchHit", "sizeBytes"]},
    {"name": "find-paper-start", "method": "POST", "path": "/api/admin/find", "session": "admin", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"id": "{{ext_song3}}"}}, "capture": {"find_pm": "json:id"}},
    {"name": "find-paper-done", "path": "/api/admin/find/{{find_pm}}", "session": "admin", "until": {"from": "json:state", "in": ["done", "failed"]}, "pollMs": 500, "timeoutMs": 90000, "backlog": "D,B", "capture": {"kilo_copy": {"from": "regex:\"peer\":\"kilo\"[^{}]*?\"id\":\"(c\\d+)\"", "normalize": false}, "lima_copy": {"from": "regex:\"peer\":\"lima\"[^{}]*?\"id\":\"(c\\d+)\"", "normalize": false}}},
    {"name": "pick-kilo-refused", "method": "POST", "path": "/api/admin/find/{{find_pm}}/pick", "session": "admin", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"copy": "{{kilo_copy}}"}}},
    {"name": "pick-kilo-refused-subsonic", "path": "/rest/pickFoundSong", "auth": "p", "query": [["search", "{{find_pm}}"], ["copy", "{{kilo_copy}}"]]},
    {"name": "pick-lima", "method": "POST", "path": "/api/admin/find/{{find_pm}}/pick", "session": "admin", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"copy": "{{lima_copy}}"}}, "delayBeforeMs": 25000},
    {"name": "pick-lima-row", "path": "/rest/getAcquisition", "auth": "p", "query": [["key", "soulseek:{{ext_song3}}"]], "until": {"regex": "\"state\":\"(done|failed)\"[\\s\\S]*\"kind\":\"lyrics\""}, "pollMs": 1000, "timeoutMs": 180000, "capture": {"paper_lib_id": "json:subsonic-response.acquisition.libraryId"}, "unordered": true, "backlog": "D,B,C"},
    {"name": "pick-lima-tags", "exec": ["ffprobe", "-v", "error", "-show_entries", "format=format_name,duration:format_tags:stream=index,codec_type,codec_name,sample_rate,channels,width,height:stream_disposition=attached_pic:stream_tags", "-of", "json", "/music/Zephyr Echo/Glass Harbor/Paper Moons.m4a"], "backlog": "B,C"},
    {"name": "pick-lima-files", "exec": ["sh", "-c", "cd /music && find './Zephyr Echo' -type f -print | LC_ALL=C sort; test -f .mappings.json && echo mappings-file: yes; echo staged-left: $(find /music/.octo-incoming -type f 2>/dev/null | wc -l)"], "backlog": "B,C"},
    {"name": "pick-lima-history-file", "exec": ["cat", "/app/config/downloads-history.json"], "until": {"regex": "\"Kind\":\"lyrics\"[\\s\\S]*\"Kind\":\"lyrics\""}, "pollMs": 1000, "timeoutMs": 30000, "unordered": true, "ignoreKeys": ["StageSeconds", "DetailsPrefetchHit", "SizeBytes"], "backlog": "D,C"},
    {"name": "pick-lima-library-song", "path": "/rest/getSong", "auth": "p", "f": "json", "query": [["id", "{{paper_lib_id}}"]], "ignoreKeys": ["size"], "backlog": "C"},
    {"name": "pick-lima-relay-download", "path": "/rest/download", "auth": "p", "query": [["id", "{{paper_lib_id}}"]], "headers": {"Range": "bytes=4-7"}, "backlog": "B"},
    {"name": "pick-lima-album-now", "path": "/rest/search3", "auth": "p", "f": "json", "query": [["query", "zephyr"]], "ignoreKeys": ["size"]},
    {"name": "pick-lima-history-list", "path": "/api/admin/downloads", "session": "admin", "ignoreKeys": ["stageSeconds", "detailsPrefetchHit", "sizeBytes"], "capture": {"paper_at": "json:downloads[0].downloadedAt"}},
    {"name": "pick-lima-saved-log", "path": "/api/admin/downloads/log", "session": "admin", "query": [["key", "soulseek:{{ext_song3}}"], ["at", "{{paper_at}}"]], "unordered": true},
    {"name": "pick-lima-acquisitions-admin", "path": "/api/admin/acquisitions", "session": "admin"},
    {"name": "clear-all-finished", "path": "/rest/clearAcquisitions", "auth": "p"},
    {"name": "clear-all-after", "path": "/rest/getAcquisitions", "auth": "p", "f": "json"},
    {"name": "clear-all-live-log-gone", "path": "/api/admin/downloads/log", "session": "admin", "query": [["key", "soulseek:{{ext_song2}}"]]},
    {"name": "clear-all-saved-log-stays", "path": "/api/admin/downloads/log", "session": "admin", "query": [["key", "soulseek:{{ext_song2}}"], ["at", "{{neon_at}}"]], "unordered": true}
  ]
}
