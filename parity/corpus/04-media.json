{
  "group": "subsonic-media",
  "description": "endpoints.md 3.4: stream (local relay with and without Range, external via the yt-dlp shim stub, credential failures, missing id), download and HEAD through the catch-all, getCoverArt branches, getTranscodeDecision, and radio/stream token routing.",
  "defaults": {"auth": "p"},
  "requests": [
    {"name": "stream-local-flac", "path": "/rest/stream", "query": [["id", "{{song_flac1}}"]]},
    {"name": "stream-local-flac-range", "path": "/rest/stream.view", "query": [["id", "{{song_flac1}}"]], "headers": {"Range": "bytes=0-99"}},
    {"name": "stream-local-flac-range-tail", "path": "/rest/stream", "query": [["id", "{{song_flac2}}"]], "headers": {"Range": "bytes=1000-"}},
    {"name": "stream-local-mp3", "path": "/rest/stream.view", "query": [["id", "{{song_mp3_1}}"]]},
    {"name": "stream-local-m4a-range", "path": "/rest/stream", "query": [["id", "{{song_m4a_1}}"]], "headers": {"Range": "bytes=0-15"}},
    {"name": "stream-local-badpass", "path": "/rest/stream", "auth": "bad", "query": [["id", "{{song_flac1}}"]]},
    {"name": "stream-local-badpass-json", "path": "/rest/stream", "auth": "bad", "f": "json", "query": [["id", "{{song_flac1}}"]]},
    {"name": "stream-unknown-id", "path": "/rest/stream", "query": [["id", "doesnotexist000000000x"]]},
    {"name": "stream-missing-id", "path": "/rest/stream"},
    {"name": "stream-missing-id-json", "path": "/rest/stream.view", "f": "json"},
    {"name": "stream-external", "path": "/rest/stream", "query": [["id", "{{ext_song}}"]]},
    {"name": "stream-external-range", "path": "/rest/stream", "query": [["id", "{{ext_song}}"]], "headers": {"Range": "bytes=100-199"}},
    {"name": "stream-external-badpass", "path": "/rest/stream", "auth": "bad", "query": [["id", "{{ext_song}}"]]},
    {"name": "stream-external-badpass-json", "path": "/rest/stream.view", "auth": "bad", "f": "json", "query": [["id", "{{ext_song}}"]]},
    {"name": "stream-head-local-catchall", "method": "HEAD", "path": "/rest/stream", "query": [["id", "{{song_mp3_2}}"]]},
    {"name": "stream-head-external-catchall", "method": "HEAD", "path": "/rest/stream", "query": [["id", "{{ext_song}}"]]},
    {"name": "download-local-catchall", "path": "/rest/download", "query": [["id", "{{song_mp3_2}}"]]},
    {"name": "download-local-range-catchall", "path": "/rest/download.view", "query": [["id", "{{song_flac3}}"]], "headers": {"Range": "bytes=0-31"}},
    {"name": "download-external-xml", "path": "/rest/download", "query": [["id", "{{ext_song}}"]]},
    {"name": "download-external-json", "path": "/rest/download.view", "f": "json", "query": [["id", "{{ext_song}}"]]},

    {"name": "cover-local-album", "path": "/rest/getCoverArt", "query": [["id", "{{album_flac}}"]]},
    {"name": "cover-local-album-size", "path": "/rest/getCoverArt.view", "query": [["id", "{{cover_flac}}"], ["size", "32"]]},
    {"name": "cover-local-song", "path": "/rest/getCoverArt", "query": [["id", "{{song_mp3_1}}"]]},
    {"name": "cover-local-no-art", "path": "/rest/getCoverArt", "query": [["id", "{{album_m4a}}"]]},
    {"name": "cover-local-badpass", "path": "/rest/getCoverArt", "auth": "bad", "query": [["id", "{{album_flac}}"]]},
    {"name": "cover-missing-id", "path": "/rest/getCoverArt"},
    {"name": "cover-octo-radio", "path": "/rest/getCoverArt", "auth": "none", "query": [["id", "octo-radio"]]},
    {"name": "cover-external-song", "path": "/rest/getCoverArt", "query": [["id", "{{ext_song}}"]]},
    {"name": "cover-external-song-octo-client", "path": "/rest/getCoverArt", "client": "Octo", "query": [["id", "{{ext_song}}"]]},
    {"name": "cover-external-album", "path": "/rest/getCoverArt.view", "query": [["id", "{{ext_album}}"]]},
    {"name": "cover-external-artist", "path": "/rest/getCoverArt", "query": [["id", "{{ext_artist}}"]]},
    {"name": "cover-legacy-ext-album", "path": "/rest/getCoverArt", "query": [["id", "ext-album-unknown"]]},
    {"name": "cover-legacy-ext-album-octo-client", "path": "/rest/getCoverArt", "client": "Octo", "query": [["id", "ext-album-unknown"]]},
    {"name": "cover-legacy-ext-typed", "path": "/rest/getCoverArt", "query": [["id", "ext-deezer-album-2001"]]},
    {"name": "cover-external-playlist", "path": "/rest/getCoverArt", "query": [["id", "pl-deezer-777"]]},
    {"name": "cover-octo-station-unknown", "path": "/rest/getCoverArt", "query": [["id", "or00000000000000000000"]]},

    {"name": "transcode-decision-local-json", "path": "/rest/getTranscodeDecision", "f": "json", "query": [["mediaId", "{{song_flac1}}"]]},
    {"name": "transcode-decision-local-xml", "path": "/rest/getTranscodeDecision.view", "query": [["mediaId", "{{song_m4a_1}}"]]},
    {"name": "transcode-decision-external", "path": "/rest/getTranscodeDecision", "query": [["mediaId", "{{ext_song}}"]]},

    {"name": "radio-stream-unknown-token", "path": "/radio/stream/000000000000000000000000000000000000000000000000", "auth": "none"},
    {"name": "radio-stream-unknown-token-head", "method": "HEAD", "path": "/radio/stream/000000000000000000000000000000000000000000000000", "auth": "none"},
    {"name": "radio-stream-short-token-catchall", "path": "/radio/stream/tooshort", "auth": "none"}
  ]
}
