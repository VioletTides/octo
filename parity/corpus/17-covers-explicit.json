{
  "group": "covers-explicit",
  "description": "Backlog P (and the explicit half of C): the cover upgrade run (scan, picked preview, a cancel that lands while the run waits on a slow stub, resume, thumbs, refusals), explicit marks on outside songs and albums (an explicit album and its clean twin with an id of its own, JSON and XML), the explicit backfill read side (preview, cancel, resume, the show filter, refusals, the state file), and Try it on a song with the advisory. Nothing here writes to the music files: every Apply and Undo that rewrites files is in 96-covers-explicit-writes.json, which runs after every file that reads the library. Needs stubs-17 (mappings/35-covers-explicit.json).",
  "defaults": {"auth": "none", "session": "admin", "backlog": "P"},
  "requests": [
    {"name": "covers-get-idle", "path": "/api/admin/covers/upgrade"},
    {"name": "covers-get-recovery-refused", "path": "/api/admin/covers/upgrade", "session": "recovery"},
    {"name": "covers-start-recovery-refused", "method": "POST", "path": "/api/admin/covers/upgrade", "session": "recovery", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"scope": "WholeLibrary", "mode": "Scan"}}},
    {"name": "covers-start-no-admin-header", "method": "POST", "path": "/api/admin/covers/upgrade", "body": {"json": {"scope": "WholeLibrary", "mode": "Scan"}}},
    {"name": "covers-start-bad-json", "method": "POST", "path": "/api/admin/covers/upgrade", "headers": {"X-Octo-Admin": "1"}, "body": {"raw": "{\"scope\": ", "contentType": "application/json"}},
    {"name": "covers-start-octo-downloads", "method": "POST", "path": "/api/admin/covers/upgrade", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"mode": "Scan"}}},
    {"name": "covers-octo-downloads-done", "path": "/api/admin/covers/upgrade", "until": {"from": "json:busy", "in": ["False"]}, "pollMs": 300, "timeoutMs": 30000, "capture": {"covers_run1": "json:runId"}},
    {"name": "covers-start-scan-whole", "method": "POST", "path": "/api/admin/covers/upgrade", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"scope": "WholeLibrary", "mode": "Scan"}}},
    {"name": "covers-scan-whole-done", "path": "/api/admin/covers/upgrade", "unordered": true, "until": {"from": "json:busy", "in": ["False"]}, "pollMs": 300, "timeoutMs": 30000, "capture": {"covers_run2": "json:runId", "cov_a": {"from": "regex:\\{(?=[^{}]*\"folder\":\"/music/Aurora Vale)[^{}]*?\"id\":\"([0-9a-f]{16})\"", "normalize": false}, "cov_b": {"from": "regex:\\{(?=[^{}]*\"folder\":\"/music/Bj)[^{}]*?\"id\":\"([0-9a-f]{16})\"", "normalize": false}, "cov_c": {"from": "regex:\\{(?=[^{}]*\"folder\":\"/music/(?!Aurora|Bj))[^{}]*?\"id\":\"([0-9a-f]{16})\"", "normalize": false}}},
    {"name": "covers-thumb-a-now", "path": "/api/admin/covers/upgrade/thumb/{{cov_a}}"},
    {"name": "covers-thumb-c-now-no-art", "path": "/api/admin/covers/upgrade/thumb/{{cov_c}}"},
    {"name": "covers-thumb-a-found-before-preview", "path": "/api/admin/covers/upgrade/thumb/{{cov_a}}", "query": [["found", "true"]]},
    {"name": "covers-thumb-unknown-id", "path": "/api/admin/covers/upgrade/thumb/0000000000000000"},
    {"name": "covers-thumb-recovery-refused", "path": "/api/admin/covers/upgrade/thumb/{{cov_a}}", "session": "recovery"},
    {"name": "covers-apply-whole-no-confirm", "method": "POST", "path": "/api/admin/covers/upgrade", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"scope": "WholeLibrary", "mode": "Apply"}}},
    {"name": "covers-apply-whole-wrong-confirm", "method": "POST", "path": "/api/admin/covers/upgrade", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"scope": "WholeLibrary", "mode": "Apply", "confirm": "/music/"}}},
    {"name": "covers-undo-nothing", "method": "POST", "path": "/api/admin/covers/upgrade/undo", "headers": {"X-Octo-Admin": "1"}},
    {"name": "covers-resume-after-completed", "method": "POST", "path": "/api/admin/covers/upgrade/resume", "headers": {"X-Octo-Admin": "1"}},
    {"name": "covers-preview-picked", "method": "POST", "path": "/api/admin/covers/upgrade", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"scope": "WholeLibrary", "mode": "Preview", "albums": ["{{cov_a}}", "{{cov_b}}", "{{cov_c}}"]}}},
    {"name": "covers-preview-again-busy", "method": "POST", "path": "/api/admin/covers/upgrade", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"scope": "WholeLibrary", "mode": "Preview", "albums": ["{{cov_a}}"]}}},
    {"name": "covers-cancel-while-waiting", "method": "POST", "path": "/api/admin/covers/upgrade/cancel", "headers": {"X-Octo-Admin": "1"}, "delayBeforeMs": 1000},
    {"name": "covers-cancelled", "path": "/api/admin/covers/upgrade", "unordered": true, "until": {"from": "json:busy", "in": ["False"]}, "pollMs": 300, "timeoutMs": 60000, "capture": {"covers_run3": "json:runId"}},
    {"name": "covers-resume", "method": "POST", "path": "/api/admin/covers/upgrade/resume", "headers": {"X-Octo-Admin": "1"}},
    {"name": "covers-resumed-done", "path": "/api/admin/covers/upgrade", "unordered": true, "until": {"from": "json:busy", "in": ["False"]}, "pollMs": 300, "timeoutMs": 60000, "ignoreKeys": ["reason"]},
    {"name": "covers-resume-after-done", "method": "POST", "path": "/api/admin/covers/upgrade/resume", "headers": {"X-Octo-Admin": "1"}},
    {"name": "covers-thumb-a-found", "path": "/api/admin/covers/upgrade/thumb/{{cov_a}}", "query": [["found", "true"]]},
    {"name": "covers-thumb-b-found", "path": "/api/admin/covers/upgrade/thumb/{{cov_b}}", "query": [["found", "true"]]},
    {"name": "covers-thumb-c-found-none", "path": "/api/admin/covers/upgrade/thumb/{{cov_c}}", "query": [["found", "true"]]},
    {"name": "covers-thumb-b-now", "path": "/api/admin/covers/upgrade/thumb/{{cov_b}}"},
    {"name": "covers-undo-after-preview-nothing", "method": "POST", "path": "/api/admin/covers/upgrade/undo", "headers": {"X-Octo-Admin": "1"}},
    {"name": "covers-cancel-idle", "method": "POST", "path": "/api/admin/covers/upgrade/cancel", "headers": {"X-Octo-Admin": "1"}},
    {"name": "covers-start-unknown-words-clamped", "method": "POST", "path": "/api/admin/covers/upgrade", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"scope": "Everything", "mode": "Bogus", "smallerThan": 0, "folderCovers": false}}},
    {"name": "covers-clamped-done", "path": "/api/admin/covers/upgrade", "until": {"from": "json:busy", "in": ["False"]}, "pollMs": 300, "timeoutMs": 30000, "capture": {"covers_run4": "json:runId"}},
    {"name": "explicit-get-idle", "path": "/api/admin/explicit/backfill"},
    {"name": "explicit-get-recovery", "path": "/api/admin/explicit/backfill", "session": "recovery"},
    {"name": "explicit-apply-before-preview", "method": "POST", "path": "/api/admin/explicit/backfill/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"confirm": "/music"}}},
    {"name": "explicit-resume-nothing", "method": "POST", "path": "/api/admin/explicit/backfill/resume", "headers": {"X-Octo-Admin": "1"}},
    {"name": "explicit-undo-nothing", "method": "POST", "path": "/api/admin/explicit/backfill/undo", "headers": {"X-Octo-Admin": "1"}},
    {"name": "explicit-preview-start", "method": "POST", "path": "/api/admin/explicit/backfill/preview", "headers": {"X-Octo-Admin": "1"}},
    {"name": "explicit-preview-again-busy", "method": "POST", "path": "/api/admin/explicit/backfill/preview", "headers": {"X-Octo-Admin": "1"}},
    {"name": "explicit-cancel-during-slow-lookup", "method": "POST", "path": "/api/admin/explicit/backfill/cancel", "headers": {"X-Octo-Admin": "1"}, "delayBeforeMs": 2500},
    {"name": "explicit-cancelled", "path": "/api/admin/explicit/backfill", "until": {"from": "json:status", "in": ["Cancelled", "Completed", "Failed"]}, "pollMs": 300, "timeoutMs": 60000, "capture": {"expl_run1": "json:runId"}},
    {"name": "explicit-cancelled-show-unsure", "path": "/api/admin/explicit/backfill", "query": [["show", "unsure"]]},
    {"name": "explicit-resume", "method": "POST", "path": "/api/admin/explicit/backfill/resume", "headers": {"X-Octo-Admin": "1"}},
    {"name": "explicit-resumed-done", "path": "/api/admin/explicit/backfill", "until": {"from": "json:status", "in": ["Completed", "Failed"]}, "pollMs": 500, "timeoutMs": 120000},
    {"name": "explicit-show-explicit", "path": "/api/admin/explicit/backfill", "query": [["show", "explicit"]]},
    {"name": "explicit-show-clean", "path": "/api/admin/explicit/backfill", "query": [["show", "clean"]]},
    {"name": "explicit-show-not-explicit", "path": "/api/admin/explicit/backfill", "query": [["show", "notExplicit"]]},
    {"name": "explicit-show-unknown-word", "path": "/api/admin/explicit/backfill", "query": [["show", "nothing"]]},
    {"name": "explicit-resume-after-done", "method": "POST", "path": "/api/admin/explicit/backfill/resume", "headers": {"X-Octo-Admin": "1"}},
    {"name": "explicit-apply-wrong-confirm", "method": "POST", "path": "/api/admin/explicit/backfill/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"confirm": "/music/"}}},
    {"name": "explicit-apply-no-body", "method": "POST", "path": "/api/admin/explicit/backfill/apply", "headers": {"X-Octo-Admin": "1"}},
    {"name": "explicit-state-file", "exec": ["cat", "/app/config/explicit-backfill.json"], "delayBeforeMs": 500, "ignoreKeys": ["WriteTicks"]},
    {"name": "explicit-cancel-recovery-idle", "method": "POST", "path": "/api/admin/explicit/backfill/cancel", "session": "recovery", "headers": {"X-Octo-Admin": "1"}},
    {"name": "tags-preview-name-explicit-catalog", "method": "POST", "path": "/api/admin/tags/preview", "headers": {"X-Octo-Admin": "1"}, "backlog": "C", "ignoreKeys": ["stageSeconds"], "body": {"json": {"artist": "Zephyr Echo", "title": "Paper Moons"}}},
    {"name": "tags-preview-name-says-clean", "method": "POST", "path": "/api/admin/tags/preview", "headers": {"X-Octo-Admin": "1"}, "backlog": "C", "ignoreKeys": ["stageSeconds"], "body": {"json": {"artist": "Velvet Static", "title": "Low Hum (Clean)"}}},
    {"name": "tags-preview-path-mp3", "method": "POST", "path": "/api/admin/tags/preview", "headers": {"X-Octo-Admin": "1"}, "backlog": "C", "ignoreKeys": ["stageSeconds"], "timeout": 90, "body": {"json": {"path": "/music/Bjørn Ålund/Ágætis Prófun (2018)/01 - Hjarta.mp3"}}},
    {"name": "tags-preview-path-m4a", "method": "POST", "path": "/api/admin/tags/preview", "headers": {"X-Octo-Admin": "1"}, "backlog": "C", "ignoreKeys": ["stageSeconds"], "timeout": 90, "body": {"json": {"path": "/music/宇多田テスト/初恋テスト (2021)/02 - 桜の歌.m4a"}}},
    {"name": "tags-preview-path-outside-music", "method": "POST", "path": "/api/admin/tags/preview", "headers": {"X-Octo-Admin": "1"}, "backlog": "C", "body": {"json": {"path": "/etc/hostname"}}},
    {"name": "search3-velvet-json", "ignoreKeys": ["duration"], "path": "/rest/search3", "auth": "p", "f": "json", "session": null, "query": [["query", "velvet"]], "capture": {"vel_song_low": {"from": "json:subsonic-response.searchResult3.song[0].id", "normalize": false}, "vel_song_bloom": {"from": "json:subsonic-response.searchResult3.song[1].id", "normalize": false}, "vel_album_e": {"from": "json:subsonic-response.searchResult3.album[0].id", "normalize": false}, "vel_album_c": {"from": "json:subsonic-response.searchResult3.album[1].id", "normalize": false}, "vel_artist": {"from": "json:subsonic-response.searchResult3.artist[0].id", "normalize": false}}},
    {"name": "search3-velvet-xml", "ignoreKeys": ["duration"], "path": "/rest/search3.view", "auth": "p", "session": null, "query": [["query", "velvet"]]},
    {"name": "search2-velvet-json", "ignoreKeys": ["duration"], "path": "/rest/search2", "auth": "p", "f": "json", "session": null, "query": [["query", "velvet"]]},
    {"name": "album-velvet-explicit-json", "path": "/rest/getAlbum", "auth": "p", "f": "json", "session": null, "query": [["id", "{{vel_album_e}}"]], "capture": {"vel_track_e": {"from": "json:subsonic-response.album.song[0].id", "normalize": false}}},
    {"name": "album-velvet-explicit-xml", "path": "/rest/getAlbum.view", "auth": "p", "session": null, "query": [["id", "{{vel_album_e}}"]]},
    {"name": "album-velvet-clean-json", "path": "/rest/getAlbum", "auth": "p", "f": "json", "session": null, "query": [["id", "{{vel_album_c}}"]], "capture": {"vel_track_c": {"from": "json:subsonic-response.album.song[0].id", "normalize": false}}},
    {"name": "album-velvet-clean-xml", "path": "/rest/getAlbum.view", "auth": "p", "session": null, "query": [["id", "{{vel_album_c}}"]]},
    {"name": "song-velvet-explicit-track-json", "path": "/rest/getSong", "auth": "p", "f": "json", "session": null, "query": [["id", "{{vel_track_e}}"]]},
    {"name": "song-velvet-clean-track-json", "path": "/rest/getSong", "auth": "p", "f": "json", "session": null, "query": [["id", "{{vel_track_c}}"]]},
    {"name": "song-velvet-clean-track-xml", "path": "/rest/getSong.view", "auth": "p", "session": null, "query": [["id", "{{vel_track_c}}"]]},
    {"name": "song-velvet-search-row-json", "ignoreKeys": ["duration"], "path": "/rest/getSong", "auth": "p", "f": "json", "session": null, "query": [["id", "{{vel_song_low}}"]]},
    {"name": "song-velvet-search-row-clean-json", "ignoreKeys": ["duration"], "path": "/rest/getSong", "auth": "p", "f": "json", "session": null, "query": [["id", "{{vel_song_bloom}}"]]},
    {"name": "artist-velvet-json", "path": "/rest/getArtist", "auth": "p", "f": "json", "session": null, "query": [["id", "{{vel_artist}}"]]},
    {"name": "artist-velvet-xml", "path": "/rest/getArtist.view", "auth": "p", "session": null, "query": [["id", "{{vel_artist}}"]]},
    {"name": "top-songs-velvet-json", "path": "/rest/getTopSongs", "auth": "p", "f": "json", "session": null, "backlog": "P,G", "query": [["artist", "Velvet Static"], ["count", "10"]]}
  ]
}
