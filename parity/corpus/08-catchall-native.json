{
  "group": "catch-all-and-native-api",
  "description": "endpoints.md 3.9 and 2.2: the external-id safety net, Octo-owned 404s, GET / (implicit [Required]), method mismatches, the faithful relay of Navidrome's native /api with JWT auth, and Octo's native-API answers for external songs, albums and artists (steps 4-10).",
  "defaults": {"auth": "p"},
  "requests": [
    {"name": "root", "path": "/", "auth": "none"},
    {"name": "favicon", "path": "/favicon.ico", "auth": "none"},
    {"name": "admin-missing-file", "path": "/admin/nope.js", "auth": "none"},
    {"name": "administrator-prefix", "path": "/administrator", "auth": "none"},
    {"name": "assets-lowercase-missing", "path": "/assets/missing.png", "auth": "none"},
    {"name": "api-admin-unknown", "path": "/api/admin/does-not-exist", "auth": "none"},
    {"name": "api-admin-settings-head", "method": "HEAD", "path": "/api/admin/settings", "auth": "none"},
    {"name": "unstar-external-safety-net-xml", "path": "/rest/unstar", "query": [["id", "{{ext_song}}"]]},
    {"name": "unstar-external-safety-net-json", "path": "/rest/unstar.view", "f": "json", "query": [["id", "{{ext_song}}"]]},
    {"name": "get-foo-external-element-name", "path": "/rest/getFooBar", "f": "xml", "query": [["albumId", "ext-deezer-album-2001"]]},
    {"name": "unknown-endpoint-relay-xml", "path": "/rest/getNothingAtAll", "query": [["id", "{{song_flac1}}"]]},
    {"name": "unknown-endpoint-relay-json", "path": "/rest/getNothingAtAll.view", "f": "json"},
    {"name": "delete-method-on-getalbum", "method": "DELETE", "path": "/rest/getAlbum", "f": "json", "query": [["id", "{{album_flac}}"]]},
    {"name": "post-json-body-relay", "method": "POST", "path": "/rest/getUser", "auth": "none",
     "body": {"json": {"u": "admin", "p": "parity-admin", "v": "1.16.1", "c": "parity", "f": "json", "username": "admin"}}},
    {"name": "post-multipart-like-form-relay", "method": "POST", "path": "/rest/getGenres.view", "auth": "none",
     "body": {"form": [["u", "admin"], ["p", "parity-admin"], ["v", "1.16.1"], ["c", "parity"]]}},

    {"name": "native-login-bad", "method": "POST", "path": "/auth/login", "auth": "none",
     "body": {"json": {"username": "admin", "password": "nope"}}},
    {"name": "native-song-list-noauth", "path": "/api/song", "auth": "none", "query": [["_start", "0"], ["_end", "5"]]},
    {"name": "native-song-list", "path": "/api/song", "auth": "none", "query": [["_start", "0"], ["_end", "20"], ["_sort", "title"], ["_order", "ASC"]],
     "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}, "ignoreKeys": ["createdAt", "updatedAt", "playDate", "birthTime"]},
    {"name": "native-album-list", "path": "/api/album", "auth": "none", "query": [["_start", "0"], ["_end", "10"], ["_sort", "name"], ["_order", "ASC"]],
     "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}, "ignoreKeys": ["createdAt", "updatedAt", "importedAt"]},
    {"name": "native-artist-list", "path": "/api/artist", "auth": "none", "query": [["_start", "0"], ["_end", "10"], ["_sort", "name"], ["_order", "ASC"]],
     "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}, "ignoreKeys": ["createdAt", "updatedAt"]},
    {"name": "native-playlist-list", "path": "/api/playlist", "auth": "none", "query": [["_start", "0"], ["_end", "10"]],
     "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}},
    {"name": "native-playlist-octo-id-get", "path": "/api/playlist/or00000000000000000000", "auth": "none",
     "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}},
    {"name": "native-playlist-octo-id-delete", "method": "DELETE", "path": "/api/playlist/og00000000000000000000", "auth": "none",
     "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}},
    {"name": "native-song-by-title-discovery", "path": "/api/song", "auth": "none", "query": [["title", "zephyr"], ["_start", "0"], ["_end", "10"]],
     "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}},
    {"name": "native-album-by-name-discovery", "path": "/api/album", "auth": "none", "query": [["name", "glass"], ["_start", "0"], ["_end", "10"]],
     "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}},
    {"name": "native-song-external", "path": "/api/song/{{ext_song}}", "auth": "none", "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}},
    {"name": "native-song-local", "path": "/api/song/{{song_flac2}}", "auth": "none", "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"},
     "ignoreKeys": ["createdAt", "updatedAt", "birthTime"]},
    {"name": "native-album-external", "path": "/api/album/{{ext_album}}", "auth": "none", "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}},
    {"name": "native-artist-external", "path": "/api/artist/{{ext_artist}}", "auth": "none", "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}},
    {"name": "native-albums-of-external-artist", "path": "/api/album", "auth": "none", "query": [["artist_id", "{{ext_artist}}"], ["_start", "0"], ["_end", "-1"]],
     "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}},
    {"name": "native-songs-of-external-album", "path": "/api/song", "auth": "none", "query": [["album_id", "{{ext_album}}"]],
     "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}},
    {"name": "native-keepalive", "path": "/api/keepalive/keepalive", "auth": "none", "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}},
    {"name": "native-bearer-header", "path": "/api/genre", "auth": "none", "headers": {"Authorization": "Bearer {{nd_token}}"}},
    {"name": "native-if-none-match-relayed", "path": "/api/genre", "auth": "none",
     "headers": {"X-ND-Authorization": "Bearer {{nd_token}}", "If-None-Match": "\"nothing\""}, "unordered": true}
  ]
}
