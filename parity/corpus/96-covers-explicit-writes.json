{
  "group": "covers-explicit-writes",
  "description": "Backlog P, the half that rewrites music files, run after every file that reads the library (after 90 and 95, before 99). A fresh explicit preview, then a cover replace on the FLAC album (iTunes 1400 px), so the explicit write that follows leaves the changed FLAC alone and marks the MP3 clean and the M4A explicit (ITUNESADVISORY, rtng), Navidrome's explicitStatus after its scan, undo; a second preview and write that marks all three, undo; then the cover undo, which must give back the fixture's own cover.jpg byte for byte. Tag and picture dumps go through ffprobe and sha256sum in the Octo container. Navidrome answers after a write carry new coverArt ids, sizes and times, so those keys are ignored on the getSong reads.",
  "defaults": {"auth": "none", "session": "admin", "backlog": "P"},
  "requests": [
    {"name": "explicit-preview-1-start", "method": "POST", "path": "/api/admin/explicit/backfill/preview", "headers": {"X-Octo-Admin": "1"}},
    {"name": "explicit-preview-1-running", "path": "/api/admin/explicit/backfill", "until": {"from": "json:status", "in": ["Running"]}, "pollMs": 150, "timeoutMs": 30000, "ignoreKeys": ["processed", "explicit", "clean", "notExplicit", "unsure", "alreadyMarked", "failed", "rows", "lastSong", "toWrite", "canApply", "canResume", "canUndo", "total", "errors", "reason", "finishedUtc"]},
    {"name": "explicit-preview-1-done", "path": "/api/admin/explicit/backfill", "until": {"from": "json:status", "in": ["Completed", "Failed"]}, "pollMs": 500, "timeoutMs": 120000, "capture": {"expl96_run": "json:runId"}},
    {"name": "covers-scan", "method": "POST", "path": "/api/admin/covers/upgrade", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"scope": "WholeLibrary", "mode": "Scan"}}},
    {"name": "covers-scan-done", "path": "/api/admin/covers/upgrade", "unordered": true, "ignoreKeys": ["id"], "until": {"from": "json:busy", "in": ["False"]}, "pollMs": 300, "timeoutMs": 30000, "capture": {"covers96_scan": "json:runId", "cov96_a": {"from": "regex:\\{(?=[^{}]*\"folder\":\"/music/Aurora Vale)[^{}]*?\"id\":\"([0-9a-f]{16})\"", "normalize": false}}},
    {"name": "covers-apply-aurora", "method": "POST", "path": "/api/admin/covers/upgrade", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"scope": "WholeLibrary", "mode": "Apply", "albums": ["{{cov96_a}}"]}}},
    {"name": "covers-apply-aurora-done", "path": "/api/admin/covers/upgrade", "unordered": true, "until": {"from": "json:busy", "in": ["False"]}, "pollMs": 300, "timeoutMs": 60000, "capture": {"covers96_apply": "json:runId"}},
    {"name": "covers-journal-after-apply", "exec": ["cat", "/app/config/cover-upgrade-journal.jsonl"]},
    {"name": "ffprobe-polar-embedded-cover", "exec": ["ffprobe", "-v", "error", "-select_streams", "v", "-show_entries", "stream=codec_name,width,height", "-of", "json", "/music/Aurora Vale/Northern Lights (2020)/02 - Polar Night.flac"]},
    {"name": "ffprobe-aurora-folder-cover", "exec": ["ffprobe", "-v", "error", "-show_entries", "stream=codec_name,width,height", "-of", "json", "/music/Aurora Vale/Northern Lights (2020)/cover.jpg"]},
    {"name": "ffprobe-hjarta-no-cover-written", "exec": ["ffprobe", "-v", "error", "-select_streams", "v", "-show_entries", "stream=codec_name,width,height", "-of", "json", "/music/Bjørn Ålund/Ágætis Prófun (2018)/01 - Hjarta.mp3"]},
    {"name": "navidrome-idle-before-apply-1", "path": "/rest/getScanStatus", "auth": "p", "f": "json", "session": null, "until": {"from": "json:subsonic-response.scanStatus.scanning", "in": [false]}, "pollMs": 300, "timeoutMs": 60000, "ignoreKeys": ["count", "folderCount", "lastScan", "elapsedTime", "scanType"]},
    {"name": "explicit-apply-1", "method": "POST", "path": "/api/admin/explicit/backfill/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"confirm": "/music"}}},
    {"name": "explicit-apply-1-done", "path": "/api/admin/explicit/backfill", "until": {"regex": "\"reason\":\"Marked "}, "pollMs": 300, "timeoutMs": 60000},
    {"name": "explicit-state-after-apply-1", "exec": ["cat", "/app/config/explicit-backfill.json"], "delayBeforeMs": 500, "ignoreKeys": ["AppliedRunId", "WriteTicks", "NavidromeId"]},
    {"name": "ffprobe-hjarta-advisory-clean", "exec": ["ffprobe", "-v", "error", "-show_entries", "format_tags", "-of", "json", "/music/Bjørn Ålund/Ágætis Prófun (2018)/01 - Hjarta.mp3"]},
    {"name": "ffprobe-sakura-rtng-explicit", "exec": ["ffprobe", "-v", "error", "-show_entries", "format_tags", "-of", "json", "/music/宇多田テスト/初恋テスト (2021)/02 - 桜の歌.m4a"]},
    {"name": "ffprobe-polar-left-alone", "exec": ["ffprobe", "-v", "error", "-show_entries", "format_tags", "-of", "json", "/music/Aurora Vale/Northern Lights (2020)/02 - Polar Night.flac"]},
    {"name": "navidrome-hjarta-clean", "path": "/rest/getSong", "auth": "p", "f": "json", "session": null, "query": [["id", "{{song_mp3_1}}"]], "until": {"from": "json:subsonic-response.song.explicitStatus", "in": ["clean"]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["coverArt", "size", "created", "bitRate"]},
    {"name": "navidrome-sakura-explicit", "path": "/rest/getSong", "auth": "p", "f": "json", "session": null, "query": [["id", "{{song_m4a_2}}"]], "until": {"from": "json:subsonic-response.song.explicitStatus", "in": ["explicit"]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["coverArt", "size", "created", "bitRate"]},
    {"name": "navidrome-sakura-explicit-xml", "path": "/rest/getSong.view", "auth": "p", "session": null, "query": [["id", "{{song_m4a_2}}"]], "ignoreKeys": ["coverArt", "size", "created", "bitRate"]},
    {"name": "navidrome-idle-before-undo-1", "path": "/rest/getScanStatus", "auth": "p", "f": "json", "session": null, "until": {"from": "json:subsonic-response.scanStatus.scanning", "in": [false]}, "pollMs": 300, "timeoutMs": 60000, "ignoreKeys": ["count", "folderCount", "lastScan", "elapsedTime", "scanType"]},
    {"name": "explicit-undo-1", "method": "POST", "path": "/api/admin/explicit/backfill/undo", "headers": {"X-Octo-Admin": "1"}},
    {"name": "explicit-undo-1-done", "path": "/api/admin/explicit/backfill", "until": {"regex": "\"reason\":\"Took the mark off "}, "pollMs": 300, "timeoutMs": 60000},
    {"name": "explicit-undo-1-again-nothing", "method": "POST", "path": "/api/admin/explicit/backfill/undo", "headers": {"X-Octo-Admin": "1"}},
    {"name": "ffprobe-hjarta-advisory-gone", "exec": ["ffprobe", "-v", "error", "-show_entries", "format_tags", "-of", "json", "/music/Bjørn Ålund/Ágætis Prófun (2018)/01 - Hjarta.mp3"]},
    {"name": "navidrome-hjarta-unmarked", "path": "/rest/getSong", "auth": "p", "f": "json", "session": null, "query": [["id", "{{song_mp3_1}}"]], "until": {"from": "json:subsonic-response.song.explicitStatus", "in": [""]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["coverArt", "size", "created", "bitRate"]},
    {"name": "navidrome-sakura-unmarked", "path": "/rest/getSong", "auth": "p", "f": "json", "session": null, "query": [["id", "{{song_m4a_2}}"]], "until": {"from": "json:subsonic-response.song.explicitStatus", "in": [""]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["coverArt", "size", "created", "bitRate"]},
    {"name": "explicit-preview-2-start", "method": "POST", "path": "/api/admin/explicit/backfill/preview", "headers": {"X-Octo-Admin": "1"}},
    {"name": "explicit-preview-2-running", "path": "/api/admin/explicit/backfill", "until": {"from": "json:status", "in": ["Running"]}, "pollMs": 150, "timeoutMs": 30000, "ignoreKeys": ["processed", "explicit", "clean", "notExplicit", "unsure", "alreadyMarked", "failed", "rows", "lastSong", "toWrite", "canApply", "canResume", "canUndo", "total", "errors", "reason", "finishedUtc"]},
    {"name": "explicit-preview-2-done", "path": "/api/admin/explicit/backfill", "until": {"from": "json:status", "in": ["Completed", "Failed"]}, "pollMs": 500, "timeoutMs": 120000, "capture": {"expl96_run2": "json:runId"}},
    {"name": "navidrome-idle-before-apply-2", "path": "/rest/getScanStatus", "auth": "p", "f": "json", "session": null, "until": {"from": "json:subsonic-response.scanStatus.scanning", "in": [false]}, "pollMs": 300, "timeoutMs": 60000, "ignoreKeys": ["count", "folderCount", "lastScan", "elapsedTime", "scanType"]},
    {"name": "explicit-apply-2", "method": "POST", "path": "/api/admin/explicit/backfill/apply", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"confirm": "/music"}}},
    {"name": "explicit-apply-2-done", "path": "/api/admin/explicit/backfill", "until": {"regex": "\"reason\":\"Marked "}, "pollMs": 300, "timeoutMs": 60000},
    {"name": "ffprobe-polar-advisory-explicit", "exec": ["ffprobe", "-v", "error", "-show_entries", "format_tags", "-of", "json", "/music/Aurora Vale/Northern Lights (2020)/02 - Polar Night.flac"]},
    {"name": "navidrome-polar-explicit", "path": "/rest/getSong", "auth": "p", "f": "json", "session": null, "query": [["id", "{{song_flac2}}"]], "until": {"from": "json:subsonic-response.song.explicitStatus", "in": ["explicit"]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["coverArt", "size", "created", "bitRate"]},
    {"name": "navidrome-idle-before-undo-2", "path": "/rest/getScanStatus", "auth": "p", "f": "json", "session": null, "until": {"from": "json:subsonic-response.scanStatus.scanning", "in": [false]}, "pollMs": 300, "timeoutMs": 60000, "ignoreKeys": ["count", "folderCount", "lastScan", "elapsedTime", "scanType"]},
    {"name": "explicit-undo-2", "method": "POST", "path": "/api/admin/explicit/backfill/undo", "headers": {"X-Octo-Admin": "1"}},
    {"name": "explicit-undo-2-done", "path": "/api/admin/explicit/backfill", "until": {"regex": "\"reason\":\"Took the mark off "}, "pollMs": 300, "timeoutMs": 60000},
    {"name": "navidrome-polar-unmarked", "path": "/rest/getSong", "auth": "p", "f": "json", "session": null, "query": [["id", "{{song_flac2}}"]], "until": {"from": "json:subsonic-response.song.explicitStatus", "in": [""]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["coverArt", "size", "created", "bitRate"]},
    {"name": "navidrome-idle-before-covers-undo", "path": "/rest/getScanStatus", "auth": "p", "f": "json", "session": null, "until": {"from": "json:subsonic-response.scanStatus.scanning", "in": [false]}, "pollMs": 300, "timeoutMs": 60000, "ignoreKeys": ["count", "folderCount", "lastScan", "elapsedTime", "scanType"]},
    {"name": "covers-undo", "method": "POST", "path": "/api/admin/covers/upgrade/undo", "headers": {"X-Octo-Admin": "1"}},
    {"name": "covers-undo-done", "path": "/api/admin/covers/upgrade", "until": {"from": "json:busy", "in": ["False"]}, "pollMs": 300, "timeoutMs": 60000, "capture": {"covers96_undo": "json:runId"}},
    {"name": "covers-undo-again-nothing", "method": "POST", "path": "/api/admin/covers/upgrade/undo", "headers": {"X-Octo-Admin": "1"}},
    {"name": "sha256-aurora-folder-cover-restored", "exec": ["sha256sum", "/music/Aurora Vale/Northern Lights (2020)/cover.jpg"]},
    {"name": "ffprobe-polar-embedded-cover-gone", "exec": ["ffprobe", "-v", "error", "-select_streams", "v", "-show_entries", "stream=codec_name,width,height", "-of", "json", "/music/Aurora Vale/Northern Lights (2020)/02 - Polar Night.flac"]},
    {"name": "navidrome-scan-settled", "path": "/rest/getScanStatus", "auth": "p", "f": "json", "session": null, "until": {"from": "json:subsonic-response.scanStatus.scanning", "in": ["False"]}, "pollMs": 500, "timeoutMs": 60000, "ignoreKeys": ["lastScan", "count", "folderCount", "elapsedTime"]}
  ]
}
