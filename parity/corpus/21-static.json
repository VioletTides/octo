{
  "group": "static-2026-10-05",
  "description": "The 2026.10.05 dashboard files (index.html, admin.js, admin.css, icons.svg): plain, HEAD, If-None-Match and Brotli/gzip, with the admin security headers every /admin answer now carries. Bodies over 64 KB are compared by hash.",
  "defaults": {"auth": "none", "session": "admin"},
  "requests": [
    {"name": "static-index", "backlog": "J,N,R", "session": null, "path": "/admin/index.html", "capture": {"etag21_index": {"from": "header:ETag", "normalize": false}}},
    {"name": "static-index-head", "backlog": "J,N,R", "session": null, "method": "HEAD", "path": "/admin/index.html"},
    {"name": "static-index-if-none-match", "backlog": "J,N,R", "session": null, "path": "/admin/index.html", "headers": {"If-None-Match": "{{etag21_index}}"}},
    {"name": "static-index-if-none-match-stale", "backlog": "J,N,R", "session": null, "path": "/admin/index.html", "headers": {"If-None-Match": "\"stale\""}},
    {"name": "static-index-br", "backlog": "J,N,R", "session": null, "path": "/admin/index.html", "headers": {"Accept-Encoding": "br"}, "capture": {"etag21_index_br": {"from": "header:ETag", "normalize": false}}},
    {"name": "static-index-br-if-none-match", "backlog": "J,N,R", "session": null, "path": "/admin/index.html", "headers": {"Accept-Encoding": "br", "If-None-Match": "{{etag21_index_br}}"}},
    {"name": "static-index-gzip", "backlog": "J,N,R", "session": null, "path": "/admin/index.html", "headers": {"Accept-Encoding": "gzip"}, "capture": {"etag21_index_gz": {"from": "header:ETag", "normalize": false}}},
    {"name": "static-index-gzip-if-none-match", "backlog": "J,N,R", "session": null, "path": "/admin/index.html", "headers": {"Accept-Encoding": "gzip", "If-None-Match": "{{etag21_index_gz}}"}},
    {"name": "static-index-br-refused-q0", "backlog": "J,N,R", "session": null, "path": "/admin/index.html", "headers": {"Accept-Encoding": "br;q=0, gzip"}},
    {"name": "static-admin-slash", "backlog": "J,N,R", "session": null, "path": "/admin/"},
    {"name": "static-admin-slash-query", "backlog": "J,N,R", "session": null, "path": "/admin/", "rawQuery": "tab=settings"},
    {"name": "static-admin-bare", "backlog": "J,N,R", "session": null, "path": "/admin"},
    {"name": "static-js", "backlog": "J,N,R", "session": null, "path": "/admin/admin.js", "capture": {"etag21_js": {"from": "header:ETag", "normalize": false}}},
    {"name": "static-js-head", "backlog": "J,N,R", "session": null, "method": "HEAD", "path": "/admin/admin.js"},
    {"name": "static-js-if-none-match", "backlog": "J,N,R", "session": null, "path": "/admin/admin.js", "headers": {"If-None-Match": "{{etag21_js}}"}},
    {"name": "static-js-br", "backlog": "J,N,R", "session": null, "path": "/admin/admin.js", "headers": {"Accept-Encoding": "gzip, br"}, "capture": {"etag21_js_br": {"from": "header:ETag", "normalize": false}}},
    {"name": "static-js-br-if-none-match", "backlog": "J,N,R", "session": null, "path": "/admin/admin.js", "headers": {"Accept-Encoding": "gzip, br", "If-None-Match": "{{etag21_js_br}}"}},
    {"name": "static-js-gzip", "backlog": "J,N,R", "session": null, "path": "/admin/admin.js", "headers": {"Accept-Encoding": "gzip"}},
    {"name": "static-css", "backlog": "J,N,R", "session": null, "path": "/admin/admin.css", "capture": {"etag21_css": {"from": "header:ETag", "normalize": false}}},
    {"name": "static-css-head", "backlog": "J,N,R", "session": null, "method": "HEAD", "path": "/admin/admin.css"},
    {"name": "static-css-if-none-match", "backlog": "J,N,R", "session": null, "path": "/admin/admin.css", "headers": {"If-None-Match": "{{etag21_css}}"}},
    {"name": "static-css-br", "backlog": "J,N,R", "session": null, "path": "/admin/admin.css", "headers": {"Accept-Encoding": "br"}},
    {"name": "static-css-gzip", "backlog": "J,N,R", "session": null, "path": "/admin/admin.css", "headers": {"Accept-Encoding": "gzip"}},
    {"name": "static-icons", "backlog": "J,N,R", "session": null, "path": "/admin/icons.svg", "capture": {"etag21_icons": {"from": "header:ETag", "normalize": false}}},
    {"name": "static-icons-head", "backlog": "J,N,R", "session": null, "method": "HEAD", "path": "/admin/icons.svg"},
    {"name": "static-icons-if-none-match", "backlog": "J,N,R", "session": null, "path": "/admin/icons.svg", "headers": {"If-None-Match": "{{etag21_icons}}"}},
    {"name": "static-icons-br", "backlog": "J,N,R", "session": null, "path": "/admin/icons.svg", "headers": {"Accept-Encoding": "br"}},
    {"name": "static-icons-gzip", "backlog": "J,N,R", "session": null, "path": "/admin/icons.svg", "headers": {"Accept-Encoding": "gzip"}},
    {"name": "static-icons-range", "backlog": "J,N,R", "session": null, "path": "/admin/icons.svg", "headers": {"Range": "bytes=0-63"}},
    {"name": "static-icons-with-admin-cookie", "backlog": "J,N,R", "path": "/admin/icons.svg", "headers": {"If-None-Match": "{{etag21_icons}}"}},
    {"name": "static-unknown-admin-file", "backlog": "J,N,R", "session": null, "path": "/admin/signin.js"}
  ]
}
