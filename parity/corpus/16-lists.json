{
  "group": "lists",
  "description": "Backlog G (top songs, the chart, Popular right now) and Q (Made for you). The listener plays and hearts two library songs first, with play times in 2020, so Rediscover and Deep Cuts have the same input on every day the corpus runs. Then getArtistTopSongs, getTopChart and the standard getTopSongs (by name, by library and outside artist id, refusals, admin and listener views), the same with search discovery switched off at runtime, then Popular right now and Made for you, switched on at runtime (both are off in the parity env so 05-playlists never races their first build), read through getPlaylists and getPlaylist, the explicit filter, and switched off again. Generated playlist ids are fixed per user (GeneratedPlaylistService.cs PlaylistId: og + base62(sha256(user|key))), computed in NOTES.md. New Releases needs the stub date template (NOTES.md).",
  "defaults": {"auth": "p", "f": "json", "session": "admin", "backlog": "G"},
  "requests": [
    {"name": "listener-star-hjarta", "path": "/rest/star", "auth": "listener", "query": [["id", "{{song_mp3_1}}"]], "backlog": "Q"},
    {"name": "listener-scrobble-hjarta-2020", "path": "/rest/scrobble", "auth": "listener", "query": [["id", "{{song_mp3_1}}"], ["submission", "true"], ["time", "1577934245000"]], "backlog": "Q"},
    {"name": "listener-scrobble-sakura-2020", "path": "/rest/scrobble", "auth": "listener", "query": [["id", "{{song_m4a_2}}"], ["submission", "true"], ["time", "1577934300000"]], "backlog": "Q"},
    {"name": "listener-song-hjarta-after-json", "path": "/rest/getSong", "auth": "listener", "query": [["id", "{{song_mp3_1}}"]], "backlog": "Q"},
    {"name": "extensions-json", "path": "/rest/getOpenSubsonicExtensions", "backlog": "G,Q"},
    {"name": "extensions-xml", "path": "/rest/getOpenSubsonicExtensions.view", "f": null, "backlog": "G,Q"},
    {"name": "artist-top-zephyr-json", "path": "/rest/getArtistTopSongs", "query": [["artist", "Zephyr Echo"]]},
    {"name": "artist-top-zephyr-by-id-json", "path": "/rest/getArtistTopSongs", "query": [["artist", "Zephyr Echo"], ["id", "{{ext_artist}}"]]},
    {"name": "artist-top-bjorn-json", "path": "/rest/getArtistTopSongs", "query": [["artist", "Bjørn Ålund"]]},
    {"name": "artist-top-bjorn-listener-json", "path": "/rest/getArtistTopSongs", "auth": "listener", "query": [["artist", "Bjørn Ålund"]]},
    {"name": "artist-top-bjorn-count2-json", "path": "/rest/getArtistTopSongs", "query": [["artist", "Bjørn Ålund"], ["count", "2"]]},
    {"name": "artist-top-bjorn-count999-json", "path": "/rest/getArtistTopSongs", "query": [["artist", "Bjørn Ålund"], ["count", "999"]]},
    {"name": "artist-top-xml-asked-still-json", "path": "/rest/getArtistTopSongs.view", "f": null, "query": [["artist", "Bjørn Ålund"]]},
    {"name": "artist-top-missing-artist-json", "path": "/rest/getArtistTopSongs"},
    {"name": "artist-top-badpass-json", "path": "/rest/getArtistTopSongs", "auth": "bad", "query": [["artist", "Bjørn Ålund"]]},
    {"name": "artist-top-unknown-artist-json", "path": "/rest/getArtistTopSongs", "query": [["artist", "Nobody Parity"]]},
    {"name": "top-chart-json", "path": "/rest/getTopChart"},
    {"name": "top-chart-listener-json", "path": "/rest/getTopChart", "auth": "listener"},
    {"name": "top-chart-count3-json", "path": "/rest/getTopChart", "query": [["count", "3"]]},
    {"name": "top-chart-badpass-json", "path": "/rest/getTopChart", "auth": "bad"},
    {"name": "top-chart-no-credentials-json", "path": "/rest/getTopChart.view", "auth": "none", "session": null},
    {"name": "top-songs-bjorn-json", "path": "/rest/getTopSongs", "query": [["artist", "Bjørn Ålund"]]},
    {"name": "top-songs-bjorn-xml", "path": "/rest/getTopSongs.view", "f": null, "query": [["artist", "Bjørn Ålund"]]},
    {"name": "top-songs-bjorn-listener-json", "path": "/rest/getTopSongs", "auth": "listener", "query": [["artist", "Bjørn Ålund"]]},
    {"name": "top-songs-bjorn-count1-json", "path": "/rest/getTopSongs", "query": [["artist", "Bjørn Ålund"], ["count", "1"]]},
    {"name": "top-songs-by-library-artist-id-json", "path": "/rest/getTopSongs", "query": [["id", "{{artist_mp3}}"]]},
    {"name": "top-songs-by-library-artist-id-xml", "path": "/rest/getTopSongs.view", "f": null, "query": [["id", "{{artist_mp3}}"], ["count", "3"]]},
    {"name": "top-songs-by-outside-artist-id-json", "path": "/rest/getTopSongs", "query": [["id", "{{ext_artist}}"]]},
    {"name": "top-songs-zephyr-by-name-xml", "path": "/rest/getTopSongs.view", "f": null, "query": [["artist", "Zephyr Echo"]]},
    {"name": "top-songs-legacy-outside-id-json", "path": "/rest/getTopSongs", "query": [["id", "ext-deezer-artist-999999"]]},
    {"name": "top-songs-unknown-library-id-json", "path": "/rest/getTopSongs", "query": [["id", "doesnotexist000000000x"]]},
    {"name": "top-songs-missing-artist-json", "path": "/rest/getTopSongs"},
    {"name": "top-songs-badpass-json", "path": "/rest/getTopSongs", "auth": "bad", "query": [["artist", "Bjørn Ålund"]]},
    {"name": "top-songs-aurora-relayed-xml", "path": "/rest/getTopSongs.view", "f": null, "query": [["artist", "Aurora Vale"]]},
    {"name": "settings-discovery-off", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"Subsonic": {"EnableSearchDiscovery": false}}}, "ignoreKeys": ["persisted"]},
    {"name": "extensions-discovery-off-json", "path": "/rest/getOpenSubsonicExtensions", "until": {"regex": "(?s)^(?!.*octoTopSongs).*\"status\":\\s*\"ok\""}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "artist-top-discovery-off-json", "path": "/rest/getArtistTopSongs", "query": [["artist", "Bjørn Ålund"]]},
    {"name": "top-chart-discovery-off-json", "path": "/rest/getTopChart"},
    {"name": "top-songs-bjorn-discovery-off-json", "path": "/rest/getTopSongs", "query": [["artist", "Bjørn Ålund"]]},
    {"name": "top-songs-bjorn-discovery-off-xml", "path": "/rest/getTopSongs.view", "f": null, "query": [["artist", "Bjørn Ålund"]]},
    {"name": "top-songs-zephyr-discovery-off-json", "path": "/rest/getTopSongs", "query": [["artist", "Zephyr Echo"]]},
    {"name": "settings-discovery-on", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"Subsonic": {"EnableSearchDiscovery": true}}}, "ignoreKeys": ["persisted"]},
    {"name": "extensions-discovery-on-json", "path": "/rest/getOpenSubsonicExtensions", "until": {"regex": "octoTopSongs"}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "settings-lists-on", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"GeneratedPlaylists": {"PopularNow": true, "NewReleases": true}}}, "ignoreKeys": ["persisted"], "backlog": "G,Q"},
    {"name": "listener-playlists-lists-json", "path": "/rest/getPlaylists", "auth": "listener", "backlog": "G,Q", "until": {"regex": "(?s)^(?=.*Popular right now)(?=.*New Releases)(?=.*Rediscover)(?=.*Deep Cuts)"}, "pollMs": 3000, "timeoutMs": 330000},
    {"name": "listener-playlists-lists-xml", "path": "/rest/getPlaylists.view", "auth": "listener", "f": null, "backlog": "G,Q"},
    {"name": "listener-popular-json", "path": "/rest/getPlaylist", "auth": "listener", "query": [["id", "ogG4nhQuWqTLKTI1zbaxBv"]]},
    {"name": "listener-popular-xml", "path": "/rest/getPlaylist.view", "auth": "listener", "f": null, "query": [["id", "ogG4nhQuWqTLKTI1zbaxBv"]]},
    {"name": "listener-new-releases-json", "path": "/rest/getPlaylist", "auth": "listener", "query": [["id", "ogxPHMK5AXYXhhdzikcbBn"]], "ignoreKeys": ["year"], "backlog": "Q"},
    {"name": "listener-new-releases-xml", "path": "/rest/getPlaylist.view", "auth": "listener", "f": null, "query": [["id", "ogxPHMK5AXYXhhdzikcbBn"]], "ignoreKeys": ["year"], "backlog": "Q"},
    {"name": "listener-rediscover-json", "path": "/rest/getPlaylist", "auth": "listener", "query": [["id", "ogNXZ6tUxebrGBAOwg7nXu"]], "backlog": "Q"},
    {"name": "listener-deep-cuts-json", "path": "/rest/getPlaylist", "auth": "listener", "query": [["id", "og5zJ7VAxN6Z8EDtF5Lxsj"]], "unordered": true, "backlog": "Q"},
    {"name": "listener-deep-cuts-xml", "path": "/rest/getPlaylist.view", "auth": "listener", "f": null, "query": [["id", "og5zJ7VAxN6Z8EDtF5Lxsj"]], "unordered": true, "backlog": "Q"},
    {"name": "admin-opens-listener-rediscover-json", "path": "/rest/getPlaylist", "query": [["id", "ogNXZ6tUxebrGBAOwg7nXu"]], "backlog": "Q"},
    {"name": "admin-opens-listener-popular-json", "path": "/rest/getPlaylist", "query": [["id", "ogG4nhQuWqTLKTI1zbaxBv"]]},
    {"name": "listener-rediscover-wrong-password-json", "path": "/rest/getPlaylist", "auth": "none", "session": null, "query": [["u", "{{listener_user}}"], ["p", "not-the-password"], ["v", "1.16.1"], ["c", "parity"], ["id", "ogNXZ6tUxebrGBAOwg7nXu"]], "backlog": "Q"},
    {"name": "listener-popular-wrong-password-xml", "path": "/rest/getPlaylist.view", "auth": "none", "session": null, "f": null, "query": [["u", "{{listener_user}}"], ["p", "not-the-password"], ["v", "1.16.1"], ["c", "parity"], ["id", "ogG4nhQuWqTLKTI1zbaxBv"]]},
    {"name": "settings-clean-only", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"Subsonic": {"ExplicitFilter": "CleanOnly"}}}, "ignoreKeys": ["persisted"]},
    {"name": "listener-popular-clean-only-json", "path": "/rest/getPlaylist", "auth": "listener", "query": [["id", "ogG4nhQuWqTLKTI1zbaxBv"]], "until": {"regex": "(?s)^(?!.*Pale Signal).*\"status\":\\s*\"ok\""}, "pollMs": 1000, "timeoutMs": 30000},
    {"name": "settings-explicit-only", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"Subsonic": {"ExplicitFilter": "ExplicitOnly"}}}, "ignoreKeys": ["persisted"]},
    {"name": "listener-popular-explicit-only-json", "path": "/rest/getPlaylist", "auth": "listener", "query": [["id", "ogG4nhQuWqTLKTI1zbaxBv"]], "until": {"regex": "(?s)^(?=.*Pale Signal)(?!.*Paper Lanterns)"}, "pollMs": 1000, "timeoutMs": 30000},
    {"name": "settings-explicit-all", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"Subsonic": {"ExplicitFilter": "All"}}}, "ignoreKeys": ["persisted"]},
    {"name": "listener-popular-all-again-json", "path": "/rest/getPlaylist", "auth": "listener", "query": [["id", "ogG4nhQuWqTLKTI1zbaxBv"]], "until": {"regex": "(?s)^(?=.*Pale Signal)(?=.*Paper Lanterns)"}, "pollMs": 1000, "timeoutMs": 30000},
    {"name": "settings-lists-off", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"GeneratedPlaylists": {"PopularNow": false, "NewReleases": false}}}, "ignoreKeys": ["persisted"], "backlog": "G,Q"},
    {"name": "listener-playlists-lists-off-json", "path": "/rest/getPlaylists", "auth": "listener", "backlog": "G,Q", "until": {"regex": "(?s)^(?!.*Popular right now)(?!.*New Releases)(?=.*Rediscover)"}, "pollMs": 1000, "timeoutMs": 15000},
    {"name": "listener-popular-after-off-json", "path": "/rest/getPlaylist", "auth": "listener", "query": [["id", "ogG4nhQuWqTLKTI1zbaxBv"]]},
    {"name": "listener-new-releases-after-off-json", "path": "/rest/getPlaylist", "auth": "listener", "query": [["id", "ogxPHMK5AXYXhhdzikcbBn"]], "backlog": "Q"},
    {"name": "extensions-final-json", "path": "/rest/getOpenSubsonicExtensions", "backlog": "G,Q"}
  ]
}
