{
  "group": "dashboard",
  "description": "Backlog N and E: the activity view (settled first, then a covers scan and an slskd rescan made on purpose), the Afterglow palette over a seeded fetched-songs log, the Soulseek Sharing card and its Share my library switch against a fixed slskd stub (match, a refused write, a list slskd never takes, an empty folder list, port check off and on, rescan refused and started), the slskd settings rules (the password never goes back out, WebUrl must be a web address), and the read and refusal side of the Library actions history and Recently removed. Order matters: the sharing flips run before the covers scan, so the activity reads at the end see a covers run seconds old, never one near the 2 minute edge. Needs stubs-18 (mappings/05-slskd-sharing.json), the env changes and the seeded downloads-history.json in NOTES.",
  "defaults": {"auth": "none", "session": "admin", "backlog": "N"},
  "requests": [
    {"name": "activity-settle", "path": "/api/admin/activity", "ignoreKeys": ["items"], "until": {"regex": "\"items\":\\[(\\{[^{}]*\"kind\":\"covers\"[^{}]*\\})?\\]"}, "pollMs": 2000, "timeoutMs": 150000},
    {"name": "activity-alt-admin-sign-in-off", "path": "/api/admin/activity", "server": "alt-admin", "session": null},
    {"name": "activity-alt-main-port-404", "path": "/api/admin/activity", "server": "alt", "session": null},
    {"name": "ambient-seeded", "path": "/api/admin/ambient"},
    {"name": "ambient-seeded-again-cached", "path": "/api/admin/ambient"},
    {"name": "ambient-recovery", "path": "/api/admin/ambient", "session": "recovery"},
    {"name": "ambient-alt-admin-unseeded", "path": "/api/admin/ambient", "server": "alt-admin", "session": null},
    {"name": "sharing-get-baseline", "path": "/api/admin/soulseek/sharing", "backlog": "E"},
    {"name": "sharing-get-recovery", "path": "/api/admin/soulseek/sharing", "session": "recovery", "backlog": "E"},
    {"name": "sharing-share-no-admin-header", "method": "POST", "path": "/api/admin/soulseek/sharing/share", "backlog": "E", "body": {"json": {"on": false}}},
    {"name": "sharing-share-bad-body", "method": "POST", "path": "/api/admin/soulseek/sharing/share", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"raw": "{\"on\": \"maybe\"}", "contentType": "application/json"}},
    {"name": "sharing-share-on-matching", "method": "POST", "path": "/api/admin/soulseek/sharing/share", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"json": {"on": true}}},
    {"name": "sharing-share-off-write-refused", "method": "POST", "path": "/api/admin/soulseek/sharing/share", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"json": {"on": false}}},
    {"name": "settings-share-library-saved-off", "path": "/api/admin/settings", "backlog": "E", "until": {"from": "json:Soulseek.ShareLibrary", "in": ["False"]}, "pollMs": 200, "timeoutMs": 10000},
    {"name": "sharing-share-off-not-taken", "method": "POST", "path": "/api/admin/soulseek/sharing/share", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "timeout": 60, "body": {"json": {"on": false}}},
    {"name": "sharing-get-after-off", "path": "/api/admin/soulseek/sharing", "backlog": "E"},
    {"name": "sharing-share-on-again", "method": "POST", "path": "/api/admin/soulseek/sharing/share", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"json": {"on": true}}},
    {"name": "settings-shared-folders-two", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"json": {"Soulseek": {"SharedFolders": "[Music]/music;!/music/incomplete"}}}},
    {"name": "settings-shared-folders-two-read", "path": "/api/admin/settings", "backlog": "E", "until": {"from": "json:Soulseek.SharedFolders", "in": ["[Music]/music;!/music/incomplete"]}, "pollMs": 200, "timeoutMs": 10000},
    {"name": "sharing-share-on-new-list-not-taken", "method": "POST", "path": "/api/admin/soulseek/sharing/share", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "timeout": 60, "body": {"json": {"on": true}}},
    {"name": "settings-shared-folders-empty", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"json": {"Soulseek": {"SharedFolders": ""}}}},
    {"name": "settings-shared-folders-empty-read", "path": "/api/admin/settings", "backlog": "E", "until": {"from": "json:Soulseek.SharedFolders", "in": [""]}, "pollMs": 200, "timeoutMs": 10000},
    {"name": "sharing-share-on-no-folders", "method": "POST", "path": "/api/admin/soulseek/sharing/share", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"json": {"on": true}}},
    {"name": "settings-shared-folders-restore", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"json": {"Soulseek": {"SharedFolders": "[Music]/music"}}}},
    {"name": "settings-shared-folders-restore-read", "path": "/api/admin/settings", "backlog": "E", "until": {"from": "json:Soulseek.SharedFolders", "in": ["[Music]/music"]}, "pollMs": 200, "timeoutMs": 10000},
    {"name": "sharing-share-on-restored", "method": "POST", "path": "/api/admin/soulseek/sharing/share", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"json": {"on": true}}},
    {"name": "settings-port-check-off", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"json": {"Soulseek": {"CheckListenPort": false}}}},
    {"name": "settings-port-check-off-read", "path": "/api/admin/settings", "backlog": "E", "until": {"from": "json:Soulseek.CheckListenPort", "in": ["False"]}, "pollMs": 200, "timeoutMs": 10000},
    {"name": "sharing-get-port-off", "path": "/api/admin/soulseek/sharing", "backlog": "E"},
    {"name": "sharing-test-port-off", "method": "POST", "path": "/api/admin/soulseek/sharing/test-port", "headers": {"X-Octo-Admin": "1"}, "backlog": "E"},
    {"name": "settings-port-check-on", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"json": {"Soulseek": {"CheckListenPort": true}}}},
    {"name": "settings-port-check-on-read", "path": "/api/admin/settings", "backlog": "E", "until": {"from": "json:Soulseek.CheckListenPort", "in": ["True"]}, "pollMs": 200, "timeoutMs": 10000},
    {"name": "sharing-test-port-open", "method": "POST", "path": "/api/admin/soulseek/sharing/test-port", "headers": {"X-Octo-Admin": "1"}, "backlog": "E"},
    {"name": "settings-slskd-password-masked", "path": "/api/admin/settings", "backlog": "E,I"},
    {"name": "raw-config-slskd-password-masked", "path": "/api/admin/raw-config", "backlog": "E,I"},
    {"name": "settings-slskd-password-typed-into-placeholder", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "backlog": "E,I", "body": {"json": {"Soulseek": {"Password": "(saved, not shown)extra"}}}},
    {"name": "settings-slskd-password-new-username", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "backlog": "E,I", "body": {"json": {"Soulseek": {"Username": "someone-else", "Password": "(saved, not shown)"}}}},
    {"name": "settings-slskd-password-new-address", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "backlog": "E,I", "body": {"json": {"Soulseek": {"BaseUrl": "http://stubs:5031", "Password": "(saved, not shown)"}}}},
    {"name": "settings-slskd-password-placeholder-echoed", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "backlog": "E,I", "body": {"json": {"Soulseek": {"Username": "slskd", "Password": "(saved, not shown)"}}}},
    {"name": "raw-config-put-slskd-typed-into-placeholder", "method": "PUT", "path": "/api/admin/raw-config", "headers": {"X-Octo-Admin": "1"}, "backlog": "E,I", "body": {"json": {"Soulseek": {"Password": "(saved, not shown)extra"}}}},
    {"name": "sharing-default-login-still-warned", "path": "/api/admin/soulseek/sharing", "backlog": "E"},
    {"name": "settings-weburl-script-refused", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"json": {"Soulseek": {"WebUrl": "javascript:alert(1)"}}}},
    {"name": "settings-weburl-bare-host-refused", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"json": {"Soulseek": {"WebUrl": "slskd.parity.test:5030"}}}},
    {"name": "settings-weburl-ok", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"json": {"Soulseek": {"WebUrl": " http://slskd.parity.test:5030 "}}}},
    {"name": "settings-weburl-ok-read", "path": "/api/admin/settings", "backlog": "E", "until": {"from": "json:Soulseek.WebUrl", "notIn": [""]}, "pollMs": 200, "timeoutMs": 10000},
    {"name": "settings-weburl-clear", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "backlog": "E", "body": {"json": {"Soulseek": {"WebUrl": ""}}}},
    {"name": "settings-weburl-clear-read", "path": "/api/admin/settings", "backlog": "E", "until": {"from": "json:Soulseek.WebUrl", "in": [""]}, "pollMs": 200, "timeoutMs": 10000},
    {"name": "library-actions-history-recovery", "path": "/api/admin/library-actions", "session": "recovery", "backlog": "F"},
    {"name": "library-actions-allow-download-no-key", "method": "POST", "path": "/api/admin/library-actions/allow-download", "headers": {"X-Octo-Admin": "1"}, "backlog": "F", "body": {"json": {}}},
    {"name": "library-actions-allow-download-unknown-key", "method": "POST", "path": "/api/admin/library-actions/allow-download", "headers": {"X-Octo-Admin": "1"}, "backlog": "F", "body": {"json": {"key": "parity-no-such-key"}}},
    {"name": "trash-recovery-refused", "path": "/api/admin/trash", "session": "recovery", "backlog": "R"},
    {"name": "trash-restore-library-actions-off", "method": "POST", "path": "/api/admin/trash/restore", "headers": {"X-Octo-Admin": "1"}, "backlog": "R", "body": {"json": {"id": "parity-no-such-song"}}},
    {"name": "trash-restore-recovery-refused", "method": "POST", "path": "/api/admin/trash/restore", "session": "recovery", "headers": {"X-Octo-Admin": "1"}, "backlog": "R", "body": {"json": {"id": "parity-no-such-song"}}},
    {"name": "covers-scan-for-activity", "method": "POST", "path": "/api/admin/covers/upgrade", "headers": {"X-Octo-Admin": "1"}, "backlog": "N,P", "body": {"json": {"scope": "WholeLibrary", "mode": "Scan"}}},
    {"name": "covers-scan-for-activity-done", "path": "/api/admin/covers/upgrade", "backlog": "N,P", "unordered": true, "until": {"from": "json:busy", "in": ["False"]}, "pollMs": 300, "timeoutMs": 30000, "capture": {"covers_run_18": "json:runId"}},
    {"name": "activity-covers-done", "path": "/api/admin/activity"},
    {"name": "sharing-rescan-already-scanning", "method": "POST", "path": "/api/admin/soulseek/sharing/rescan", "headers": {"X-Octo-Admin": "1"}, "backlog": "E"},
    {"name": "activity-no-rescan-watch-after-refusal", "path": "/api/admin/activity"},
    {"name": "sharing-rescan-started", "method": "POST", "path": "/api/admin/soulseek/sharing/rescan", "headers": {"X-Octo-Admin": "1"}, "backlog": "E"},
    {"name": "activity-rescan-starting", "path": "/api/admin/activity", "backlog": "N,E", "capture": {"rescan_ticks": "regex:share-rescan:(\\d+)"}},
    {"name": "activity-rescan-done", "path": "/api/admin/activity", "backlog": "N,E", "delayBeforeMs": 15500},
    {"name": "activity-recovery-signed", "path": "/api/admin/activity", "session": "recovery"},
    {"name": "activity-alt-admin-after", "path": "/api/admin/activity", "server": "alt-admin", "session": null}
  ]
}
