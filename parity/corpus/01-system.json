{
  "group": "subsonic-system-auth",
  "description": "endpoints.md 3.1 and 2.2-2.4: ping in every auth form and format, routing quirks (case, trailing slash, method mismatch), getOpenSubsonicExtensions merge, jukeboxControl, and the plain relays for the system endpoints.",
  "defaults": {"auth": "p"},
  "requests": [
    {"name": "ping-xml-view", "path": "/rest/ping.view"},
    {"name": "ping-xml-plain", "path": "/rest/ping"},
    {"name": "ping-json-view", "path": "/rest/ping.view", "f": "json"},
    {"name": "ping-json-plain", "path": "/rest/ping", "f": "json"},
    {"name": "ping-json-token", "path": "/rest/ping.view", "auth": "t", "f": "json"},
    {"name": "ping-xml-token", "path": "/rest/ping.view", "auth": "t"},
    {"name": "ping-json-enc", "path": "/rest/ping.view", "auth": "enc", "f": "json"},
    {"name": "ping-json-listener", "path": "/rest/ping.view", "auth": "listener", "f": "json"},
    {"name": "ping-json-badpass", "path": "/rest/ping.view", "auth": "bad", "f": "json"},
    {"name": "ping-xml-badpass", "path": "/rest/ping.view", "auth": "bad"},
    {"name": "ping-json-apikey", "path": "/rest/ping.view", "auth": "apikey", "f": "json"},
    {"name": "ping-json-u-only", "path": "/rest/ping.view", "auth": "u-only", "f": "json"},
    {"name": "ping-xml-noauth", "path": "/rest/ping.view", "auth": "none"},
    {"name": "ping-json-noauth", "path": "/rest/ping", "auth": "none", "f": "json"},
    {"name": "ping-jsonp", "path": "/rest/ping.view", "f": "jsonp", "query": [["callback", "cb"]]},
    {"name": "ping-f-uppercase-value", "path": "/rest/ping.view", "f": "JSON"},
    {"name": "ping-F-uppercase-key", "path": "/rest/ping.view", "rawQuery": "u=admin&p=parity-admin&v=1.16.1&c=parity&F=json"},
    {"name": "ping-case-insensitive", "path": "/REST/Ping.VIEW", "f": "json"},
    {"name": "ping-trailing-slash", "path": "/rest/ping/", "f": "json"},
    {"name": "ping-post-form", "method": "POST", "path": "/rest/ping.view", "auth": "none",
     "body": {"form": [["u", "admin"], ["p", "parity-admin"], ["v", "1.16.1"], ["c", "parity"], ["f", "json"]]}},
    {"name": "ping-post-form-overrides-query", "method": "POST", "path": "/rest/ping.view", "auth": "bad", "f": "xml",
     "body": {"form": [["p", "parity-admin"], ["f", "json"]]}},
    {"name": "ping-post-json-body", "method": "POST", "path": "/rest/ping", "auth": "none",
     "body": {"json": {"u": "admin", "p": "parity-admin", "v": "1.16.1", "c": "parity", "f": "json"}}},
    {"name": "ping-put-falls-to-catchall", "method": "PUT", "path": "/rest/ping", "f": "json"},
    {"name": "ping-head-falls-to-catchall", "method": "HEAD", "path": "/rest/ping"},
    {"name": "ping-options-not-preflight", "method": "OPTIONS", "path": "/rest/ping", "f": "json"},

    {"name": "extensions-json", "path": "/rest/getOpenSubsonicExtensions", "f": "json"},
    {"name": "extensions-xml", "path": "/rest/getOpenSubsonicExtensions.view"},
    {"name": "extensions-json-noauth", "path": "/rest/getOpenSubsonicExtensions.view", "auth": "none", "f": "json"},
    {"name": "extensions-xml-badpass", "path": "/rest/getOpenSubsonicExtensions", "auth": "bad"},
    {"name": "extensions-f-JSON", "path": "/rest/getOpenSubsonicExtensions", "f": "JSON"},

    {"name": "jukebox-xml", "path": "/rest/jukeboxControl.view", "query": [["action", "status"]]},
    {"name": "jukebox-json", "path": "/rest/jukeboxControl", "f": "json", "query": [["action", "get"]]},
    {"name": "jukebox-noauth-json", "path": "/rest/jukeboxControl", "auth": "none", "f": "json"},

    {"name": "license-xml", "path": "/rest/getLicense.view"},
    {"name": "license-json", "path": "/rest/getLicense", "f": "json"},
    {"name": "music-folders-json", "path": "/rest/getMusicFolders", "f": "json"},
    {"name": "music-folders-xml", "path": "/rest/getMusicFolders.view"},
    {"name": "user-json", "path": "/rest/getUser", "f": "json", "query": [["username", "admin"]]},
    {"name": "users-xml", "path": "/rest/getUsers.view"},
    {"name": "scan-status-json", "path": "/rest/getScanStatus", "f": "json", "ignoreKeys": ["elapsedTime"]},
    {"name": "genres-json", "path": "/rest/getGenres", "f": "json"},
    {"name": "genres-xml", "path": "/rest/getGenres.view"},
    {"name": "token-info-apikey", "path": "/rest/tokenInfo", "auth": "apikey", "f": "json"}
  ]
}
