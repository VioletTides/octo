{
  "group": "radio",
  "description": "Backlog L (multi-source radio) at C# 2026.10.05. Radio is off in the parity env; this file turns it on through the settings API, waits for each change to show, and turns it off again at the end, so no other corpus file sees radio on. Order: the gate on the two new admin routes; Sounds alike (octo-sonic stub) settled through its first pass, its controls, and the service probe in every state; then song radio from a library song, a remix, an album, an artist, a song no catalog knows (#78 guess), an outside song and refusals; then one listener's one-star ban, filler, learning from plays and skips, the outcome stats and reset; then source weights and switches. Every answer is deterministic: the blend is ordered by score then first sight (RadioBlend.cs:122), and the two random paths (LastFmRadioTrackResolver.cs:147 shuffle, Navidrome getRandomSongs for genre neighbours) only ever yield the fixture's 2 to 4 second songs, which RadioFiller drops as filler before the blend. See NOTES.md.",
  "defaults": {"auth": "p", "f": "json", "session": "admin", "backlog": "L"},
  "requests": [
    {"name": "outcomes-signed-out", "path": "/api/admin/radio-outcomes", "auth": "none", "f": null, "session": null, "backlog": "L,J"},
    {"name": "sonic-signed-out", "path": "/api/admin/sonic", "auth": "none", "f": null, "session": null, "backlog": "L,J"},
    {"name": "outcomes-subsonic-creds-no-session", "path": "/api/admin/radio-outcomes", "auth": "p", "f": null, "session": null, "backlog": "L,J"},
    {"name": "sonic-start-signed-out", "method": "POST", "path": "/api/admin/sonic/start", "auth": "none", "f": null, "session": null, "headers": {"X-Octo-Admin": "1"}, "backlog": "L,J"},
    {"name": "outcomes-reset-no-admin-header", "method": "POST", "path": "/api/admin/radio-outcomes/reset", "auth": "none", "f": null},
    {"name": "sonic-pause-no-admin-header", "method": "POST", "path": "/api/admin/sonic/pause", "auth": "none", "f": null},
    {"name": "outcomes-empty", "path": "/api/admin/radio-outcomes", "auth": "none", "f": null},
    {"name": "status-sonic-reachable", "path": "/api/admin/status", "auth": "none", "f": null},
    {"name": "sonic-first-pass-done", "path": "/api/admin/sonic", "auth": "none", "f": null, "until": {"regex": "(?s)^(?=.*\"state\":\\s*\"Done\")(?=.*\"pass\":\\s*1\\b)"}, "pollMs": 1000, "timeoutMs": 240000},
    {"name": "sonic-features-file", "anyKeyOrder": true, "exec": ["cat", "/app/config/sonic-features.json"], "ignoreKeys": ["Stamp"]},
    {"name": "sonic-pause", "method": "POST", "path": "/api/admin/sonic/pause", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}},
    {"name": "settings-sonic-url-off", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"RadioSources": {"SonicUrl": "http://octo-sonic/off"}}}, "ignoreKeys": ["persisted"]},
    {"name": "status-sonic-off-in-env", "path": "/api/admin/status", "auth": "none", "f": null, "until": {"from": "json:services.sonic.detail", "in": ["Sounds alike is off in .env"]}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "settings-sonic-url-blind", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"RadioSources": {"SonicUrl": "http://octo-sonic/blind"}}}, "ignoreKeys": ["persisted"]},
    {"name": "status-sonic-cannot-see-music", "path": "/api/admin/status", "auth": "none", "f": null, "until": {"from": "json:services.sonic.detail", "in": ["cannot see the music folder"]}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "settings-sonic-url-broken", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"RadioSources": {"SonicUrl": "http://octo-sonic/broken"}}}, "ignoreKeys": ["persisted"]},
    {"name": "status-sonic-http-500", "path": "/api/admin/status", "auth": "none", "f": null, "until": {"from": "json:services.sonic.detail", "in": ["HTTP 500"]}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "settings-sonic-url-restore", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"RadioSources": {"SonicUrl": "http://octo-sonic"}}}, "ignoreKeys": ["persisted"]},
    {"name": "status-sonic-reachable-again", "path": "/api/admin/status", "auth": "none", "f": null, "until": {"from": "json:services.sonic.detail", "in": ["reachable"]}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "settings-sounds-alike-off", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"RadioSources": {"SoundsAlike": false}}}, "ignoreKeys": ["persisted"]},
    {"name": "status-sounds-alike-off", "path": "/api/admin/status", "auth": "none", "f": null, "until": {"from": "json:services.sonic.detail", "in": ["Sounds alike is off"]}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "status-signed-out-sounds-alike-off", "path": "/api/admin/status", "auth": "none", "f": null, "session": null, "delayBeforeMs": 10500, "backlog": "L,J"},
    {"name": "settings-sounds-alike-on", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"RadioSources": {"SoundsAlike": true}}}, "ignoreKeys": ["persisted"]},
    {"name": "status-sounds-alike-on", "path": "/api/admin/status", "auth": "none", "f": null, "until": {"from": "json:services.sonic.detail", "in": ["reachable"]}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "sonic-paused-settled", "path": "/api/admin/sonic", "auth": "none", "f": null, "until": {"from": "json:state", "in": ["Paused"]}, "pollMs": 1000, "timeoutMs": 90000},
    {"name": "sonic-start", "method": "POST", "path": "/api/admin/sonic/start", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}},
    {"name": "sonic-reset", "method": "POST", "path": "/api/admin/sonic/reset", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}},
    {"name": "sonic-after-reset-pass-done", "path": "/api/admin/sonic", "auth": "none", "f": null, "until": {"regex": "(?s)^(?=.*\"state\":\\s*\"Done\")(?=.*\"pass\":\\s*1\\b)"}, "pollMs": 1000, "timeoutMs": 90000},
    {"name": "settings-radio-on", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"LastFm": {"EnableRadio": true}, "ListenBrainz": {"Token": "parity-lb-token"}}}, "ignoreKeys": ["persisted"]},
    {"name": "extensions-radio-on-json", "path": "/rest/getOpenSubsonicExtensions", "until": {"regex": "octoRadioSources"}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "extensions-radio-on-xml", "path": "/rest/getOpenSubsonicExtensions.view", "f": null},
    {"name": "similar-polar-json", "path": "/rest/getSimilarSongs", "query": [["id", "{{song_flac2}}"], ["count", "30"]], "unordered": true},
    {"name": "similar2-polar-xml", "path": "/rest/getSimilarSongs2.view", "f": null, "query": [["id", "{{song_flac2}}"], ["count", "30"]], "unordered": true},
    {"name": "similar-polar-count5-json", "path": "/rest/getSimilarSongs", "query": [["id", "{{song_flac2}}"], ["count", "5"]], "unordered": true},
    {"name": "similar-polar-count0-json", "path": "/rest/getSimilarSongs", "query": [["id", "{{song_flac2}}"], ["count", "0"]]},
    {"name": "similar-polar-count500-json", "path": "/rest/getSimilarSongs", "query": [["id", "{{song_flac2}}"], ["count", "500"]], "unordered": true},
    {"name": "similar-polar-post-form-json", "method": "POST", "path": "/rest/getSimilarSongs", "body": {"form": [["id", "{{song_flac2}}"], ["count", "5"]]}, "unordered": true},
    {"name": "similar2-remix-original-json", "path": "/rest/getSimilarSongs2", "query": [["id", "{{song_m4a_3}}"], ["count", "10"]], "unordered": true},
    {"name": "similar2-remix-original-xml", "path": "/rest/getSimilarSongs2.view", "f": null, "query": [["id", "{{song_m4a_3}}"], ["count", "10"]], "unordered": true},
    {"name": "similar-album-nothing-relayed-json", "path": "/rest/getSimilarSongs", "query": [["id", "{{album_flac}}"], ["count", "10"]]},
    {"name": "similar2-artist-json", "path": "/rest/getSimilarSongs2", "query": [["id", "{{artist_mp3}}"], ["count", "20"]], "unordered": true},
    {"name": "similar-artist-xml", "path": "/rest/getSimilarSongs.view", "f": null, "query": [["id", "{{artist_mp3}}"], ["count", "20"]], "unordered": true},
    {"name": "similar-guessed-artists-json", "path": "/rest/getSimilarSongs", "query": [["id", "{{song_mp3_2}}"], ["count", "10"]], "unordered": true},
    {"name": "similar-external-json", "path": "/rest/getSimilarSongs", "query": [["id", "{{ext_song}}"], ["count", "10"]], "unordered": true},
    {"name": "similar2-external-xml", "path": "/rest/getSimilarSongs2.view", "f": null, "query": [["id", "{{ext_song}}"], ["count", "10"]], "unordered": true},
    {"name": "similar-external-badpass-json", "path": "/rest/getSimilarSongs", "auth": "bad", "query": [["id", "{{ext_song}}"], ["count", "10"]], "unordered": true},
    {"name": "similar-local-badpass-json", "path": "/rest/getSimilarSongs", "auth": "bad", "query": [["id", "{{song_flac2}}"], ["count", "10"]], "unordered": true},
    {"name": "similar-unknown-id-json", "path": "/rest/getSimilarSongs", "query": [["id", "doesnotexist000000000x"]]},
    {"name": "similar-missing-id-xml", "path": "/rest/getSimilarSongs.view", "f": null},
    {"name": "similar2-missing-id-json", "path": "/rest/getSimilarSongs2"},
    {"name": "similar-listener-polar-json", "path": "/rest/getSimilarSongs", "auth": "listener", "query": [["id", "{{song_flac2}}"], ["count", "30"]], "unordered": true},
    {"name": "scrobble-start-slow-bloom", "path": "/rest/scrobble", "auth": "listener", "query": [["id", "D3Uwg0MmNkZFdmJB31UB86"], ["submission", "false"]]},
    {"name": "scrobble-start-night-ferry", "path": "/rest/scrobble", "auth": "listener", "query": [["id", "NtxMWtJb80J7L8xLeBxnv1"], ["submission", "false"]]},
    {"name": "scrobble-finish-night-ferry-skip", "path": "/rest/scrobble", "auth": "listener", "query": [["id", "NtxMWtJb80J7L8xLeBxnv1"], ["submission", "true"]]},
    {"name": "rate-low-tide-one-star", "path": "/rest/setRating", "auth": "listener", "query": [["id", "e6lr3FrQ4cI17mf2gvX6W3"], ["rating", "1"]]},
    {"name": "outcomes-after-skips", "path": "/api/admin/radio-outcomes", "auth": "none", "f": null},
    {"name": "similar-listener-polar-banned-json", "path": "/rest/getSimilarSongs", "auth": "listener", "query": [["id", "{{song_flac2}}"], ["count", "30"]], "unordered": true},
    {"name": "similar-admin-polar-not-banned-json", "path": "/rest/getSimilarSongs", "query": [["id", "{{song_flac2}}"], ["count", "30"]], "unordered": true},
    {"name": "scrobble-finish-slow-bloom-keep", "path": "/rest/scrobble", "auth": "listener", "delayBeforeMs": 31000, "query": [["id", "D3Uwg0MmNkZFdmJB31UB86"], ["submission", "true"]]},
    {"name": "outcomes-after-keep", "path": "/api/admin/radio-outcomes", "auth": "none", "f": null},
    {"name": "rate-low-tide-three-stars", "path": "/rest/setRating", "auth": "listener", "query": [["id", "e6lr3FrQ4cI17mf2gvX6W3"], ["rating", "3"]]},
    {"name": "similar-listener-polar-unbanned-json", "path": "/rest/getSimilarSongs", "auth": "listener", "query": [["id", "{{song_flac2}}"], ["count", "30"]], "unordered": true},
    {"name": "outcomes-reset", "method": "POST", "path": "/api/admin/radio-outcomes/reset", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}},
    {"name": "outcomes-after-reset", "path": "/api/admin/radio-outcomes", "auth": "none", "f": null},
    {"name": "outcomes-file-after-reset", "exec": ["cat", "/app/config/radio-outcomes.json"]},
    {"name": "settings-learning-off", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"RadioSources": {"LearnFromListening": false}}}, "ignoreKeys": ["persisted"]},
    {"name": "settings-learning-off-read", "path": "/api/admin/settings", "auth": "none", "f": null, "until": {"regex": "\"LearnFromListening\":\\s*false"}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "similar-listener-learning-off-json", "path": "/rest/getSimilarSongs", "auth": "listener", "query": [["id", "{{song_flac2}}"], ["count", "30"]], "unordered": true},
    {"name": "scrobble-start-night-ferry-learning-off", "path": "/rest/scrobble", "auth": "listener", "query": [["id", "NtxMWtJb80J7L8xLeBxnv1"], ["submission", "false"]]},
    {"name": "scrobble-finish-night-ferry-learning-off", "path": "/rest/scrobble", "auth": "listener", "query": [["id", "NtxMWtJb80J7L8xLeBxnv1"], ["submission", "true"]]},
    {"name": "outcomes-learning-off", "path": "/api/admin/radio-outcomes", "auth": "none", "f": null},
    {"name": "settings-learning-on", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"RadioSources": {"LearnFromListening": true}}}, "ignoreKeys": ["persisted"]},
    {"name": "settings-learning-on-read", "path": "/api/admin/settings", "auth": "none", "f": null, "until": {"regex": "\"LearnFromListening\":\\s*true"}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "settings-ytm-weight-zero", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"RadioSources": {"YouTubeMusicWeight": 0}}}, "ignoreKeys": ["persisted"]},
    {"name": "similar-polar-ytm-weight-zero-json", "path": "/rest/getSimilarSongs", "query": [["id", "{{song_flac2}}"], ["count", "30"]], "until": {"regex": "(?s)^(?!.*Slow Bloom).*\"status\":\\s*\"ok\""}, "pollMs": 500, "timeoutMs": 20000, "unordered": true},
    {"name": "settings-ytm-weight-restore", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"RadioSources": {"YouTubeMusicWeight": 1.0}}}, "ignoreKeys": ["persisted"]},
    {"name": "similar-polar-ytm-weight-restored-json", "path": "/rest/getSimilarSongs", "query": [["id", "{{song_flac2}}"], ["count", "30"]], "until": {"regex": "Slow Bloom"}, "pollMs": 500, "timeoutMs": 20000, "unordered": true},
    {"name": "settings-listenbrainz-off", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"RadioSources": {"ListenBrainz": false}}}, "ignoreKeys": ["persisted"]},
    {"name": "similar-polar-listenbrainz-off-json", "path": "/rest/getSimilarSongs", "query": [["id", "{{song_flac2}}"], ["count", "30"]], "until": {"regex": "(?s)^(?!.*Cinders).*\"status\":\\s*\"ok\""}, "pollMs": 500, "timeoutMs": 20000, "unordered": true},
    {"name": "settings-listenbrainz-on", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"RadioSources": {"ListenBrainz": true}}}, "ignoreKeys": ["persisted"]},
    {"name": "similar-polar-listenbrainz-on-json", "path": "/rest/getSimilarSongs", "query": [["id", "{{song_flac2}}"], ["count", "30"]], "until": {"regex": "Cinders"}, "pollMs": 500, "timeoutMs": 20000, "unordered": true},
    {"name": "settings-radio-off", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"LastFm": {"EnableRadio": false}, "ListenBrainz": {"Token": ""}}}, "ignoreKeys": ["persisted"]},
    {"name": "extensions-radio-off-json", "path": "/rest/getOpenSubsonicExtensions", "until": {"regex": "(?s)^(?!.*octoRadioSources).*\"status\":\\s*\"ok\""}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "similar-polar-radio-off-relayed-json", "path": "/rest/getSimilarSongs", "query": [["id", "{{song_flac2}}"]]},
    {"name": "outcomes-final", "path": "/api/admin/radio-outcomes", "auth": "none", "f": null},
    {"name": "sonic-final", "path": "/api/admin/sonic", "auth": "none", "f": null}
