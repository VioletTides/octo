{
  "group": "subsonic-browsing",
  "description": "endpoints.md 3.2 and the browsing relays of 3.9: getSong/getArtist/getAlbum with local, external and missing ids (the local album and artist merge with the Deezer catalog), album/artist info, random and similar songs, and the passthrough browsing endpoints.",
  "defaults": {"auth": "p"},
  "requests": [
    {"name": "song-local-json", "path": "/rest/getSong", "f": "json", "query": [["id", "{{song_flac1}}"]]},
    {"name": "song-local-xml", "path": "/rest/getSong.view", "query": [["id", "{{song_flac1}}"]]},
    {"name": "song-local-m4a-json", "path": "/rest/getSong.view", "f": "json", "query": [["id", "{{song_m4a_2}}"]]},
    {"name": "song-local-mp3-xml", "path": "/rest/getSong", "query": [["id", "{{song_mp3_3}}"]]},
    {"name": "song-missing-id-json", "path": "/rest/getSong", "f": "json"},
    {"name": "song-missing-id-xml", "path": "/rest/getSong.view"},
    {"name": "song-unknown-id-json", "path": "/rest/getSong", "f": "json", "query": [["id", "doesnotexist000000000x"]]},
    {"name": "song-external-json", "path": "/rest/getSong", "f": "json", "query": [["id", "{{ext_song}}"]]},
    {"name": "song-external-xml", "path": "/rest/getSong.view", "query": [["id", "{{ext_song}}"]]},
    {"name": "song-legacy-ext-json", "path": "/rest/getSong", "f": "json", "query": [["id", "ext-deezer-song-3001"]]},
    {"name": "song-badpass-local-json", "path": "/rest/getSong", "auth": "bad", "f": "json", "query": [["id", "{{song_flac1}}"]]},

    {"name": "artist-local-json", "path": "/rest/getArtist", "f": "json", "query": [["id", "{{artist_flac}}"]]},
    {"name": "artist-local-xml", "path": "/rest/getArtist.view", "query": [["id", "{{artist_flac}}"]]},
    {"name": "artist-local-cjk-json", "path": "/rest/getArtist.view", "f": "json", "query": [["id", "{{artist_m4a}}"]]},
    {"name": "artist-local-jsonp", "path": "/rest/getArtist", "f": "jsonp", "query": [["id", "{{artist_mp3}}"], ["callback", "cb"]]},
    {"name": "artist-missing-id-xml", "path": "/rest/getArtist"},
    {"name": "artist-unknown-json", "path": "/rest/getArtist", "f": "json", "query": [["id", "doesnotexist000000000x"]]},
    {"name": "artist-external-json", "path": "/rest/getArtist", "f": "json", "query": [["id", "{{ext_artist}}"]]},
    {"name": "artist-external-xml", "path": "/rest/getArtist.view", "query": [["id", "{{ext_artist}}"]]},
    {"name": "artist-badpass-json", "path": "/rest/getArtist", "auth": "bad", "f": "json", "query": [["id", "{{artist_flac}}"]]},

    {"name": "album-local-flac-xml", "path": "/rest/getAlbum.view", "query": [["id", "{{album_flac}}"]]},
    {"name": "album-local-mp3-json", "path": "/rest/getAlbum", "f": "json", "query": [["id", "{{album_mp3}}"]]},
    {"name": "album-local-m4a-xml", "path": "/rest/getAlbum", "query": [["id", "{{album_m4a}}"]]},
    {"name": "album-local-jsonp", "path": "/rest/getAlbum", "f": "jsonp", "query": [["id", "{{album_flac}}"], ["callback", "cb"]]},
    {"name": "album-missing-id-json", "path": "/rest/getAlbum", "f": "json"},
    {"name": "album-unknown-xml", "path": "/rest/getAlbum.view", "query": [["id", "doesnotexist000000000x"]]},
    {"name": "album-external-json", "path": "/rest/getAlbum", "f": "json", "query": [["id", "{{ext_album}}"]]},
    {"name": "album-external-xml", "path": "/rest/getAlbum.view", "query": [["id", "{{ext_album}}"]]},
    {"name": "album-legacy-ext-json", "path": "/rest/getAlbum", "f": "json", "query": [["id", "ext-deezer-album-2001"]]},
    {"name": "album-external-playlist-json", "path": "/rest/getAlbum", "f": "json", "query": [["id", "pl-deezer-777"]]},

    {"name": "album-info2-local-json", "path": "/rest/getAlbumInfo2", "f": "json", "query": [["id", "{{album_flac}}"]]},
    {"name": "album-info-v1-local-xml", "path": "/rest/getAlbumInfo.view", "query": [["id", "{{album_flac}}"]]},
    {"name": "album-info2-external-json", "path": "/rest/getAlbumInfo2", "f": "json", "query": [["id", "{{ext_album}}"]]},
    {"name": "album-info2-external-xml", "path": "/rest/getAlbumInfo2.view", "query": [["id", "{{ext_album}}"]]},
    {"name": "artist-info2-local-json", "path": "/rest/getArtistInfo2", "f": "json", "query": [["id", "{{artist_flac}}"]]},
    {"name": "artist-info-v1-local-xml", "path": "/rest/getArtistInfo", "query": [["id", "{{artist_mp3}}"]]},
    {"name": "artist-info2-external-json", "path": "/rest/getArtistInfo2.view", "f": "json", "query": [["id", "{{ext_artist}}"]]},
    {"name": "artist-info-v1-external-xml", "path": "/rest/getArtistInfo.view", "query": [["id", "{{ext_artist}}"]]},

    {"name": "random-songs-json", "path": "/rest/getRandomSongs", "f": "json", "query": [["size", "50"]], "unordered": true},
    {"name": "random-songs-xml", "path": "/rest/getRandomSongs.view", "query": [["size", "50"]], "unordered": true},
    {"name": "random-songs-badpass", "path": "/rest/getRandomSongs", "auth": "bad", "f": "json"},
    {"name": "similar-songs-local-json", "path": "/rest/getSimilarSongs", "f": "json", "query": [["id", "{{song_flac2}}"]]},
    {"name": "similar-songs2-local-xml", "path": "/rest/getSimilarSongs2.view", "query": [["id", "{{artist_flac}}"], ["count", "5"]]},
    {"name": "similar-songs2-missing-id-json", "path": "/rest/getSimilarSongs2", "f": "json"},
    {"name": "similar-songs-external-json", "path": "/rest/getSimilarSongs.view", "f": "json", "query": [["id", "{{ext_song}}"]]},

    {"name": "artists-json", "path": "/rest/getArtists", "f": "json", "ignoreKeys": ["lastModified"]},
    {"name": "artists-xml", "path": "/rest/getArtists.view", "ignoreKeys": ["lastModified"]},
    {"name": "indexes-json", "path": "/rest/getIndexes", "f": "json", "ignoreKeys": ["lastModified"]},
    {"name": "music-directory-artist-json", "path": "/rest/getMusicDirectory", "f": "json", "query": [["id", "{{artist_flac}}"]]},
    {"name": "music-directory-album-xml", "path": "/rest/getMusicDirectory.view", "query": [["id", "{{album_mp3}}"]]},
    {"name": "album-list2-alpha-xml", "path": "/rest/getAlbumList2.view", "query": [["type", "alphabeticalByName"]]},
    {"name": "album-list2-artist-json", "path": "/rest/getAlbumList2", "f": "json", "query": [["type", "alphabeticalByArtist"]]},
    {"name": "album-list2-byyear-json", "path": "/rest/getAlbumList2", "f": "json", "query": [["type", "byYear"], ["fromYear", "2019"], ["toYear", "2022"]]},
    {"name": "album-list2-bygenre-json", "path": "/rest/getAlbumList2", "f": "json", "query": [["type", "byGenre"], ["genre", "J-Pop"]]},
    {"name": "album-list2-newest-json", "path": "/rest/getAlbumList2", "f": "json", "query": [["type", "newest"]], "unordered": true},
    {"name": "album-list-v1-xml", "path": "/rest/getAlbumList.view", "query": [["type", "alphabeticalByName"], ["size", "10"]]},
    {"name": "songs-by-genre-json", "path": "/rest/getSongsByGenre", "f": "json", "query": [["genre", "Electronic"]], "unordered": true},
    {"name": "starred2-empty-json", "path": "/rest/getStarred2", "f": "json"},
    {"name": "starred-empty-xml", "path": "/rest/getStarred.view"},
    {"name": "now-playing-empty-json", "path": "/rest/getNowPlaying", "f": "json"},
    {"name": "top-songs-json", "path": "/rest/getTopSongs", "f": "json", "query": [["artist", "Aurora Vale"]]},
    {"name": "play-queue-json", "path": "/rest/getPlayQueue", "f": "json"},
    {"name": "bookmarks-xml", "path": "/rest/getBookmarks.view"},
    {"name": "shares-json", "path": "/rest/getShares", "f": "json"},
    {"name": "repeated-id-relay-json", "path": "/rest/getSong", "f": "json", "query": [["id", "{{song_flac1}}"], ["id", "{{song_flac2}}"]]}
  ]
}
