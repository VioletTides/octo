{
  "group": "admin",
  "description": "endpoints.md section 4 and 2.9: the /admin redirect, every admin GET that is safe to repeat, the AdminRequestGuard (OPTIONS, writes without X-Octo-Admin, CORS stripping), browse-session gating with and without a session (cookie and header forms), validation 400s, and the side-effect-free POSTs. Signed in to the dashboard (session admin) apart from the requests marked with a null session, which check the signed-out answers; 11-signin.json asks every admin route signed out. State-changing admin calls are in 90-mutations.json.",
  "defaults": {"auth": "none", "session": "admin"},
  "requests": [
    {"name": "admin-root-redirect", "path": "/admin"},
    {"name": "admin-root-slash-redirect", "path": "/admin/"},

    {"name": "settings", "path": "/api/admin/settings"},
    {"name": "settings-with-origin-no-cors", "path": "/api/admin/settings", "headers": {"Origin": "http://evil.example"}},
    {"name": "raw-config", "path": "/api/admin/raw-config"},
    {"name": "config-sources", "path": "/api/admin/config-sources"},
    {"name": "status", "path": "/api/admin/status"},
    {"name": "library-status", "path": "/api/admin/library-status"},
    {"name": "lidarr-options", "path": "/api/admin/lidarr/options"},
    {"name": "lastfm-radio", "path": "/api/admin/lastfm/radio"},
    {"name": "lastfm-radio-user", "path": "/api/admin/lastfm/radio", "query": [["user", "admin"]]},
    {"name": "lastfm-scrobble", "path": "/api/admin/lastfm/scrobble"},
    {"name": "listenbrainz-validate-empty", "path": "/api/admin/listenbrainz/validate"},
    {"name": "listenbrainz-validate-token", "path": "/api/admin/listenbrainz/validate", "query": [["user", "admin"], ["token", "not-a-token"]]},
    {"name": "downloads", "path": "/api/admin/downloads"},
    {"name": "acquisitions", "path": "/api/admin/acquisitions"},
    {"name": "review-sweep", "path": "/api/admin/review-sweep"},
    {"name": "quality-upgrade", "path": "/api/admin/quality-upgrade"},
    {"name": "genre-presets", "path": "/api/admin/genre/presets"},
    {"name": "update", "path": "/api/admin/update"},
    {"name": "browse-session-none", "session": null, "path": "/api/admin/browse/session"},

    {"name": "guard-options", "method": "OPTIONS", "path": "/api/admin/settings"},
    {"name": "guard-options-preflight", "method": "OPTIONS", "path": "/api/admin/settings",
     "headers": {"Origin": "http://evil.example", "Access-Control-Request-Method": "POST", "Access-Control-Request-Headers": "content-type,x-octo-admin"}},
    {"name": "guard-post-no-header", "method": "POST", "path": "/api/admin/settings", "body": {"json": {"Server": {"PublicUrl": "x"}}}},
    {"name": "guard-put-no-header", "method": "PUT", "path": "/api/admin/raw-config", "body": {"json": {}}},
    {"name": "guard-delete-no-header", "method": "DELETE", "path": "/api/admin/lastfm/radio/history", "query": [["user", "admin"]]},
    {"name": "guard-post-no-header-with-origin", "method": "POST", "path": "/api/admin/restart", "headers": {"Origin": "http://evil.example"}},
    {"name": "guard-post-unknown-path-no-header", "method": "POST", "path": "/api/admin/nothing-here"},
    {"name": "guard-post-unknown-path-with-header", "method": "POST", "path": "/api/admin/nothing-here", "headers": {"X-Octo-Admin": "1"}},

    {"name": "session-browse-none", "session": null, "path": "/api/admin/browse", "query": [["path", "/music"]]},
    {"name": "session-library-actions-none", "session": null, "path": "/api/admin/library-actions"},
    {"name": "session-notices-none", "session": null, "path": "/api/admin/notices"},
    {"name": "session-lossy-none", "session": null, "path": "/api/admin/lossy"},
    {"name": "session-upgrades-none", "session": null, "path": "/api/admin/upgrades"},
    {"name": "session-genre-backfill-none", "session": null, "path": "/api/admin/genre/backfill"},
    {"name": "session-covers-upgrade-none", "session": null, "path": "/api/admin/covers/upgrade"},
    {"name": "session-cover-thumb-none", "session": null, "path": "/api/admin/covers/upgrade/thumb/{{album_flac}}"},
    {"name": "session-lyrics-library-none", "session": null, "path": "/api/admin/lyrics/library"},
    {"name": "session-lyrics-songs-none", "session": null, "path": "/api/admin/lyrics/songs", "query": [["q", "polar"]]},
    {"name": "session-lyrics-candidates-none", "session": null, "path": "/api/admin/lyrics/candidates", "query": [["id", "{{song_flac2}}"]]},
    {"name": "session-lyrics-choices-none", "session": null, "path": "/api/admin/lyrics/choices"},
    {"name": "session-library-resolve-none", "session": null, "path": "/api/admin/library/resolve", "query": [["id", "{{song_flac1}}"]]},
    {"name": "session-tags-preview-none", "session": null, "method": "POST", "path": "/api/admin/tags/preview", "headers": {"X-Octo-Admin": "1"},
     "body": {"json": {"artist": "Zephyr Echo", "title": "Glass Harbor"}}},
    {"name": "session-bogus-header-token", "path": "/api/admin/library-actions", "headers": {"X-Octo-Browse-Token": "not-a-session"}},

    {"name": "browse-auth-wrong-password", "session": null, "method": "POST", "path": "/api/admin/browse/auth", "headers": {"X-Octo-Admin": "1"},
     "body": {"json": {"username": "admin", "password": "nope"}}},
    {"name": "browse-auth-blank", "session": null, "method": "POST", "path": "/api/admin/browse/auth", "headers": {"X-Octo-Admin": "1"},
     "body": {"json": {"username": "", "password": ""}}},
    {"name": "browse-auth-not-admin", "session": null, "method": "POST", "path": "/api/admin/browse/auth", "headers": {"X-Octo-Admin": "1"},
     "body": {"json": {"username": "{{listener_user}}", "password": "{{listener_pass}}"}}},
    {"name": "browse-auth-empty-body", "session": null, "method": "POST", "path": "/api/admin/browse/auth", "headers": {"X-Octo-Admin": "1", "Content-Type": "application/json"},
     "body": {"raw": ""}},
    {"name": "browse-auth-admin", "session": null, "method": "POST", "path": "/api/admin/browse/auth", "headers": {"X-Octo-Admin": "1"},
     "body": {"json": {"Username": "{{admin_user}}", "Password": "{{admin_pass}}"}},
     "capture": {"browse_token": "cookie:octo_browse"}},

    {"name": "browse-session-cookie", "path": "/api/admin/browse/session", "headers": {"Cookie": "octo_browse={{browse_token}}"}},
    {"name": "browse-session-header-only", "path": "/api/admin/browse/session", "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "browse-music-root", "path": "/api/admin/browse", "query": [["path", "/music"]], "headers": {"Cookie": "octo_browse={{browse_token}}"}},
    {"name": "browse-album-dir-header", "path": "/api/admin/browse", "query": [["path", "/music/Aurora Vale/Northern Lights (2020)"]], "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "browse-stale-cookie-hides-header", "path": "/api/admin/browse", "query": [["path", "/music"]],
     "headers": {"Cookie": "octo_browse=stale", "X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "library-actions", "path": "/api/admin/library-actions", "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "notices", "path": "/api/admin/notices", "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "lossy", "path": "/api/admin/lossy", "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}, "unordered": true},
    {"name": "upgrades", "path": "/api/admin/upgrades", "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "genre-backfill", "path": "/api/admin/genre/backfill", "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "covers-upgrade", "path": "/api/admin/covers/upgrade", "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "cover-thumb-navidrome", "path": "/api/admin/covers/upgrade/thumb/{{album_flac}}", "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "cover-thumb-found-missing", "path": "/api/admin/covers/upgrade/thumb/{{album_flac}}", "query": [["found", "true"]], "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "cover-thumb-bad-bool", "path": "/api/admin/covers/upgrade/thumb/{{album_flac}}", "query": [["found", "maybe"]], "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "lyrics-library-busy-collision", "path": "/api/admin/lyrics/library", "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "lyrics-songs", "path": "/api/admin/lyrics/songs", "query": [["q", "polar"]], "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "lyrics-songs-blank", "path": "/api/admin/lyrics/songs", "query": [["q", ""]], "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "lyrics-candidates", "path": "/api/admin/lyrics/candidates", "query": [["id", "{{song_flac2}}"]], "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "lyrics-candidates-unknown", "path": "/api/admin/lyrics/candidates", "query": [["id", "doesnotexist000000000x"]], "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "lyrics-choices", "path": "/api/admin/lyrics/choices", "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "library-resolve", "path": "/api/admin/library/resolve", "query": [["id", "{{song_flac1}}"]], "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "library-resolve-missing-id", "path": "/api/admin/library/resolve", "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "tags-preview-artist-title", "method": "POST", "path": "/api/admin/tags/preview",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}, "body": {"json": {"artist": "Zephyr Echo", "title": "Glass Harbor"}}, "ignoreKeys": ["stageSeconds"]},
    {"name": "tags-preview-missing-title", "method": "POST", "path": "/api/admin/tags/preview",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}, "body": {"json": {"artist": "Zephyr Echo"}}},
    {"name": "tags-preview-path-traversal", "method": "POST", "path": "/api/admin/tags/preview",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}, "body": {"json": {"path": "/music/../etc/passwd"}}},
    {"name": "tags-preview-real-file", "method": "POST", "path": "/api/admin/tags/preview",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}, "body": {"json": {"path": "/music/Aurora Vale/Northern Lights (2020)/02 - Polar Night.flac"}}, "ignoreKeys": ["stageSeconds"]},

    {"name": "settings-post-empty-body", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1", "Content-Type": "application/json"}, "body": {"raw": ""}},
    {"name": "settings-post-invalid-json", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "body": {"raw": "{not json", "contentType": "application/json"}},
    {"name": "settings-post-placeholder-plus-text", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"},
     "body": {"json": {"Subsonic": {"AdminPassword": "(saved, not shown)x"}}}},
    {"name": "settings-post-libraryactions-no-users", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"},
     "body": {"json": {"LibraryActions": {"Enabled": true, "AllowedUsers": []}}}},
    {"name": "raw-config-put-array", "method": "PUT", "path": "/api/admin/raw-config", "headers": {"X-Octo-Admin": "1"}, "body": {"raw": "[]", "contentType": "application/json"}},
    {"name": "raw-config-put-empty", "method": "PUT", "path": "/api/admin/raw-config", "headers": {"X-Octo-Admin": "1", "Content-Type": "application/json"}, "body": {"raw": ""}},
    {"name": "lidarr-test-saved", "method": "POST", "path": "/api/admin/lidarr/test", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {}}},
    {"name": "lidarr-test-unreachable", "method": "POST", "path": "/api/admin/lidarr/test", "headers": {"X-Octo-Admin": "1"},
     "body": {"json": {"baseUrl": "http://stubs:9", "apiKey": "x"}}},
    {"name": "lastfm-check", "method": "POST", "path": "/api/admin/lastfm/check", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {}}},
    {"name": "lastfm-connect-unavailable", "method": "POST", "path": "/api/admin/lastfm/scrobble/connect", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"user": "admin"}}},
    {"name": "lastfm-radio-refresh-no-user", "method": "POST", "path": "/api/admin/lastfm/radio/refresh", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {}}},
    {"name": "lastfm-radio-history-no-user", "method": "DELETE", "path": "/api/admin/lastfm/radio/history", "headers": {"X-Octo-Admin": "1"}},
    {"name": "listenbrainz-validate-post", "method": "POST", "path": "/api/admin/listenbrainz/validate", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"token": "not-a-token"}}},
    {"name": "lyrics-review-dismiss-no-path", "method": "POST", "path": "/api/admin/lyrics/review/dismiss",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}, "body": {"json": {}}},
    {"name": "lyrics-choice-no-candidate", "method": "POST", "path": "/api/admin/lyrics/choice",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}, "body": {"json": {"id": "{{song_flac2}}"}}},
    {"name": "covers-upgrade-no-albums", "method": "POST", "path": "/api/admin/covers/upgrade",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}, "body": {"json": {"albums": []}}},
    {"name": "lyrics-library-preview-no-picks", "method": "POST", "path": "/api/admin/lyrics/library",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}, "body": {"json": {"mode": "Preview", "picked": []}}},
    {"name": "genre-backfill-off", "method": "POST", "path": "/api/admin/genre/backfill",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}, "body": {"json": {"dryRun": true}}},
    {"name": "upgrades-post-no-songs", "method": "POST", "path": "/api/admin/upgrades",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}, "body": {"json": {"songs": []}}},
    {"name": "duplicates-scan-off", "method": "POST", "path": "/api/admin/duplicates/scan", "headers": {"X-Octo-Admin": "1"}},
    {"name": "review-sweep-start-off", "method": "POST", "path": "/api/admin/review-sweep/start", "headers": {"X-Octo-Admin": "1"}},
    {"name": "update-post-disabled", "method": "POST", "path": "/api/admin/update", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"tag": "2099.01.01.1"}}}
  ]
}
